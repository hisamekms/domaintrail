---
// Starlight's Hero, as the approved preview has it: the title, the lead, a row of facts (`heroMeta`), the actions, and
// beside them a figure of the guide's example (`heroFigure`) when the page names one.
import Icon, { type IconName } from '../Icon.astro';
import Figure from '../Figure.astro';
import { withBase } from '../../journey';

// Starlight's id of the page title (its constants are not exported)
const PAGE_TITLE_ID = '_top';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
const href = (link: string): string => (/^[a-z]+:/.test(link) ? link : withBase(link));
---

<div class:list={['hero2', { single: !data.heroFigure }]}>
    <div>
        <h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
        {tagline && <p class="lead" set:html={tagline} />}
        {
            data.heroMeta && (
                <div class="meta">
                    {data.heroMeta.map((m) => (
                        <span>
                            <Icon name={m.icon as IconName} size={15} /> {m.text}
                        </span>
                    ))}
                </div>
            )
        }
        <div class="cta">
            {
                actions.map((a, i) => (
                    <a class={i === 0 ? 'p' : 's'} href={href(a.link)}>
                        {a.text}
                    </a>
                ))
            }
        </div>
    </div>
    {data.heroFigure && <Figure name={data.heroFigure} alt={data.heroFigureAlt ?? data.title} caption={data.heroFigureCaption} />}
</div>
