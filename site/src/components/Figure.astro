---
// A figure generated from an example workspace: a sticky-note diagram (public/figures/<name>.svg, scripts/figures.ts) or
// a capture of the Live View (public/shots/<name>.png, scripts/shots.ts). Never drawn by hand.
import Icon from './Icon.astro';
import { withBase } from '../journey';

interface Props {
    /** the figure's name in figures.json, or a capture's name */
    name: string;
    kind?: 'figure' | 'shot';
    alt: string;
    caption?: string;
    /** a label above the figure (before / after) */
    label?: string;
}

const { name, kind = 'figure', alt, caption, label } = Astro.props;
const src = withBase(kind === 'figure' ? `figures/${name}.svg` : `shots/${name}.png`);
---

<figure class="gen not-content">
    {label && <span class="lbl">{label}</span>}
    <a href={src} class="frame"><img src={src} alt={alt} loading="lazy" /></a>
    <figcaption>
        <span class="auto"><Icon name="sparkles" size={12} /> {kind === 'figure' ? '例から自動で描画' : '例から自動で撮影'}</span>
        {caption && <span>{caption}</span>}
    </figcaption>
</figure>
