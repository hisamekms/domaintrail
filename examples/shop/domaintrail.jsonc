{
  "$schema": "../../schema/domaintrail.schema.json",
  // DSL files of this example (paths are relative to this file)
  "sources": ["**/*.dt"],
  "generate": {
    // src/ imports the generated contracts from here; the contract tests go to generated/domain/tests,
    // with an adapter for bun:test (src/contract.test.ts)
    "ts": { "out": "generated/domain", "tests": { "runner": "bun" } }
  },
  "view": { "port": 4321 }
}
