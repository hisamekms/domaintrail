{
  "$schema": "../../schema/domaintrail.schema.json",
  // DSL files of this example (paths are relative to this file)
  "sources": ["**/*.dt", "**/*.dtes"],
  "generate": {
    // src/ imports the generated contracts from here; the contract tests go to generated/domain/tests,
    // with an adapter for bun:test (src/contract.test.ts)
    "ts": {
      "out": "generated/domain",
      // Billing's policies must be implemented (Billing.BillingPolicyHandlers), and the contract tests run them;
      // the other contexts keep the default, "optional"
      "contexts": { "Billing": { "policies": "required" } },
      "tests": { "runner": "bun" },
    },
  },
  "view": { "port": 4321 },
}
