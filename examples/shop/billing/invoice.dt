context Billing {
  id InvoiceId "請求書ID": UUID

  aggregate Invoice "請求書" {
    id: InvoiceId
    references order: Sales.OrderId -> Sales.Order
    billedAmount: Money "請求金額"

    state Open "未払い"
    state Paid "支払済み" {
      paidAt: Timestamp
    }

    create command issue(id: InvoiceId, order: Sales.OrderId, billedAmount: Money "請求金額") "請求書を発行する" -> Open

    command pay(paidAt: Timestamp) "支払う"
      Open -> Paid
      emits InvoicePaid
  }

  /// 入金の記録として残す。
  persistent event InvoicePaid "支払完了" {
    invoiceId: InvoiceId
    paidAt: Timestamp
  }
}
