context Sales {
  id CustomerId "顧客ID": UUID

  aggregate Customer "顧客" {
    id: CustomerId
    name: String
    email: EmailAddress

    create command register(id: CustomerId, name: String, email: EmailAddress) "顧客を登録する"
      emits CustomerRegistered

    command rename(name: String) "氏名を変更する"
      changes name
  }

  event CustomerRegistered "顧客登録" {
    customerId: CustomerId
  }
}
