context Sales {
  id OrderId "注文ID": UUID
  id OrderItemId "注文明細ID": UUID

  enum CancelReason "取消理由" { Requested "顧客都合" Other "その他" }

  primitive Quantity "数量": Int { value in 1..999 }

  /// 英大文字3桁-数字4桁の商品コード。
  primitive Sku "商品コード": String { matches(value, "^[A-Z]{3}-\d{4}$") }

  /// 顧客からの購入依頼。確定後は明細を変更できない。
  aggregate Order "注文" {
    id: OrderId
    owns items: OrderItem[0..*] "明細"
    references customer: CustomerId -> Customer
    note: String?

    invariant quantitiesPositive "数量は正の値" { all(items, item => item.quantity > 0) }
    invariant distinctSkus "商品コードは明細ごとに一意" { unique(items, item => item.sku) }
    /// 請求額を1つの金額にまとめられるよう、注文の単価は1つの通貨で揃える。
    invariant singleCurrency "単価の通貨が揃っている" {
      all(items, a => all(items, b => a.unitPrice.currency == b.unitPrice.currency))
    }

    create command place(id: OrderId, customer: CustomerId) "注文する"
      -> Draft
      emits OrderPlaced

    state Draft "下書き"

    state Confirmed "確定済み" {
      confirmedAt: Timestamp
      invariant hasItems "明細が1件以上" { count(items) > 0 }
    }

    state Cancelled "取消済み" {
      reason: CancelReason
      /// 「その他」で取り消す場合は理由を備考に残す。
      invariant otherNeedsNote "その他の取消には備考が必要" { reason == CancelReason.Other implies exists(note) }
    }

    command addItem(item: OrderItem "追加する明細") "明細を追加する"
      Draft -> Draft
      requires newSku "同じ商品コードの明細がない" { all(items, i => i.sku != item.sku) } else DuplicateSku
      requires sameCurrency "既存の明細と同じ通貨" {
        all(items, i => i.unitPrice.currency == item.unitPrice.currency)
      } else CurrencyMismatch
      changes items

    command confirm(at: Timestamp) "注文を確定する"
      Draft -> Confirmed
      requires hasItems "明細が1件以上" { count(items) > 0 } else EmptyOrder
      emits OrderConfirmed

    command cancel(reason: CancelReason) "注文を取り消す"
      Draft | Confirmed -> Cancelled
      requires noteForOther "その他の取消には備考が必要" {
        reason == CancelReason.Other implies exists(note)
      } else NoteRequired
      emits OrderCancelled,
            RefundRequested when Confirmed -> // 確定済みの注文を取り消したときだけ

    /// 確定後も備考は変更できる。状態は変わらない。
    /// 備考が変わらなければイベントは発生しない。
    command changeNote(note: String?) "備考を変更する"
      Draft -> Draft
      Confirmed -> Confirmed
      changes note
      emits NoteChanged?
  }

  entity OrderItem "注文明細" {
    id: OrderItemId
    sku: Sku
    quantity: Quantity
    owns unitPrice: Money "単価"
  }

  persistent event OrderPlaced "注文受付" {
    orderId: OrderId
  }

  persistent event OrderConfirmed "注文確定" {
    orderId: OrderId
    confirmedAt: Timestamp
  }

  event OrderCancelled "注文取消" {
    orderId: OrderId
    reason: CancelReason
  }

  /// 確定済みの注文の取消により、支払いの払い戻しが必要になった。
  event RefundRequested "返金依頼" {
    orderId: OrderId
  }

  event NoteChanged "備考変更" {
    orderId: OrderId
    note: String?
  }

  /// 明細が1件もない注文は確定できない。
  error EmptyOrder "明細なし"

  /// 追加しようとした明細と同じ商品コードの明細が、すでに注文にある。
  error DuplicateSku "商品コードの重複" {
    sku: Sku
  }

  /// 追加しようとした明細の単価が、すでにある明細と違う通貨で書かれている。
  error CurrencyMismatch "通貨の不一致"

  /// 「その他」で取り消すのに、注文に備考がない。
  error NoteRequired "備考なし"
}
