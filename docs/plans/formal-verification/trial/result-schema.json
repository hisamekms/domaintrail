{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domaintrail.dev/schemas/formal-verification-trial-attempt.json",
  "title": "Formal verification syntax trial attempt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "phase",
    "arm",
    "model",
    "guide",
    "task_id",
    "attempt_number",
    "exhausted",
    "prototype_build_hash",
    "packet_version",
    "comparison_id",
    "prompt_version",
    "metrics",
    "reviewers",
    "adjudication"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "pilot",
        "main"
      ]
    },
    "arm": {
      "enum": [
        "A0",
        "M2",
        "M3",
        "Q2"
      ]
    },
    "comparison_id": {
      "enum": [
        "A0_shared",
        "M2_vs_A0",
        "M3_vs_A0",
        "Q2_vs_A0"
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "id",
        "version",
        "pinned_at"
      ],
      "properties": {
        "family": {
          "enum": [
            "Claude",
            "Codex"
          ]
        },
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "pinned_at": {
          "type": "string",
          "format": "date-time"
        },
        "settings": {
          "type": "object"
        }
      }
    },
    "guide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256",
        "template_version",
        "allowed_diff"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "template_version": {
          "type": "string"
        },
        "allowed_diff": {
          "type": "string"
        }
      }
    },
    "prototype_build_hash": {
      "type": "string"
    },
    "packet_version": {
      "type": "string"
    },
    "task_id": {
      "type": "string",
      "pattern": "^WS-[0-9]{2}$"
    },
    "attempt_number": {
      "type": "integer",
      "minimum": 1
    },
    "exhausted": {
      "type": "boolean"
    },
    "model_artifact_id": {
      "type": "string"
    },
    "model_artifact_version": {
      "type": "string"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_syntax_check_success",
        "first_type_check_success",
        "semantic_correctness",
        "repair_count",
        "token_use",
        "repair_success_from_diagnostics"
      ],
      "properties": {
        "first_syntax_check_success": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "first_type_check_success": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "semantic_correctness": {
          "enum": [
            "pass",
            "fail",
            "uncertain"
          ]
        },
        "repair_count": {
          "type": "integer",
          "minimum": 0
        },
        "token_use": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "first_input",
            "first_output",
            "repair_input",
            "repair_output"
          ],
          "properties": {
            "first_input": {
              "type": "integer",
              "minimum": 0
            },
            "first_output": {
              "type": "integer",
              "minimum": 0
            },
            "repair_input": {
              "type": "integer",
              "minimum": 0
            },
            "repair_output": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "repair_success_from_diagnostics": {
          "type": [
            "integer",
            "null"
          ],
          "enum": [
            0,
            1,
            null
          ]
        }
      }
    },
    "reviewers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reviewer_id",
          "verdict",
          "checklist_results"
        ],
        "properties": {
          "reviewer_id": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "uncertain"
            ]
          },
          "checklist_results": {
            "type": "object",
            "additionalProperties": {
              "enum": [
                "pass",
                "fail",
                "uncertain"
              ]
            }
          },
          "scenario_results": {
            "type": "object",
            "additionalProperties": {
              "enum": [
                "pass",
                "fail",
                "not_run"
              ]
            }
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "third_reviewer_id",
        "verdict",
        "reason"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "third_reviewer_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "uncertain",
            "not_needed"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "type": "string"
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diagnostics_and_repairs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "normalized_model": {
          "type": "string"
        },
        "scenario_mapping": {
          "type": "object"
        },
        "scenario_results": {
          "type": "object"
        }
      }
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reviewers": {
            "contains": {
              "properties": {
                "verdict": {
                  "const": "pass"
                }
              }
            },
            "minContains": 1,
            "maxContains": 1
          }
        },
        "required": [
          "reviewers"
        ]
      },
      "then": {
        "properties": {
          "adjudication": {
            "properties": {
              "required": {
                "const": true
              },
              "verdict": {
                "not": {
                  "const": "not_needed"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reviewers": {
            "contains": {
              "properties": {
                "verdict": {
                  "const": "fail"
                }
              }
            },
            "minContains": 1,
            "maxContains": 1
          }
        },
        "required": [
          "reviewers"
        ]
      },
      "then": {
        "properties": {
          "adjudication": {
            "properties": {
              "required": {
                "const": true
              },
              "verdict": {
                "not": {
                  "const": "not_needed"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reviewers": {
            "contains": {
              "properties": {
                "verdict": {
                  "const": "uncertain"
                }
              }
            },
            "minContains": 1,
            "maxContains": 1
          }
        },
        "required": [
          "reviewers"
        ]
      },
      "then": {
        "properties": {
          "adjudication": {
            "properties": {
              "required": {
                "const": true
              },
              "verdict": {
                "not": {
                  "const": "not_needed"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "arm": {
            "const": "A0"
          }
        },
        "required": [
          "arm"
        ]
      },
      "then": {
        "properties": {
          "comparison_id": {
            "const": "A0_shared"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "arm": {
            "const": "M2"
          }
        },
        "required": [
          "arm"
        ]
      },
      "then": {
        "properties": {
          "comparison_id": {
            "const": "M2_vs_A0"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "arm": {
            "const": "M3"
          }
        },
        "required": [
          "arm"
        ]
      },
      "then": {
        "properties": {
          "comparison_id": {
            "const": "M3_vs_A0"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "arm": {
            "const": "Q2"
          }
        },
        "required": [
          "arm"
        ]
      },
      "then": {
        "properties": {
          "comparison_id": {
            "const": "Q2_vs_A0"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reviewers": {
            "contains": {
              "properties": {
                "verdict": {
                  "const": "pass"
                }
              }
            },
            "minContains": 2
          }
        },
        "required": [
          "reviewers"
        ]
      },
      "then": {
        "properties": {
          "adjudication": {
            "properties": {
              "required": {
                "const": false
              },
              "third_reviewer_id": {
                "const": null
              },
              "verdict": {
                "const": "not_needed"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reviewers": {
            "contains": {
              "properties": {
                "verdict": {
                  "const": "fail"
                }
              }
            },
            "minContains": 2
          }
        },
        "required": [
          "reviewers"
        ]
      },
      "then": {
        "properties": {
          "adjudication": {
            "properties": {
              "required": {
                "const": false
              },
              "third_reviewer_id": {
                "const": null
              },
              "verdict": {
                "const": "not_needed"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reviewers": {
            "contains": {
              "properties": {
                "verdict": {
                  "const": "uncertain"
                }
              }
            },
            "minContains": 2
          }
        },
        "required": [
          "reviewers"
        ]
      },
      "then": {
        "properties": {
          "adjudication": {
            "properties": {
              "required": {
                "const": false
              },
              "third_reviewer_id": {
                "const": null
              },
              "verdict": {
                "const": "not_needed"
              }
            }
          }
        }
      }
    }
  ]
}
