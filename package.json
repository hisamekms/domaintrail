{
  "name": "domaintrail",
  "version": "0.6.0",
  "description": "Domain Modeling DSL — type-checkable domain models shared by humans and AI",
  "license": "MIT",
  "author": "hisamekms",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hisamekms/domaintrail.git"
  },
  "homepage": "https://github.com/hisamekms/domaintrail#readme",
  "bugs": {
    "url": "https://github.com/hisamekms/domaintrail/issues"
  },
  "keywords": [
    "ddd",
    "domain-driven-design",
    "domain-modeling",
    "dsl",
    "typescript",
    "codegen"
  ],
  "type": "module",
  "bin": {
    "dt": "dist/dt.js",
    "domaintrail": "dist/dt.js"
  },
  "files": [
    "dist",
    "schema",
    "CHANGELOG.md",
    "CHANGELOG.ja.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "web"
  ],
  "scripts": {
    "langium:generate": "langium generate --file packages/modeling/langium-config.json",
    "build": "bun run langium:generate && bun ./scripts/build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun test",
    "dt": "bun ./bin/dt.ts",
    "tree-sitter": "bun ./scripts/tree-sitter.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "commander": "15.0.0",
    "elkjs": "0.12.0",
    "ignore": "7.0.14",
    "langium": "4.4.0",
    "picomatch": "4.0.7",
    "vscode-languageserver": "10.1.2",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@domaintrail/composition": "workspace:*",
    "@domaintrail/modeling": "workspace:*",
    "@domaintrail/presentation": "workspace:*",
    "@domaintrail/visualization": "workspace:*",
    "@domaintrail/web": "workspace:*",
    "@domaintrail/workspace": "workspace:*",
    "@types/bun": "^1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fast-check": "4.10.2",
    "langium-cli": "4.4.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vscode-jsonrpc": "10.0.0",
    "web-tree-sitter": "0.27.1"
  }
}
