{
  "name": "domaintrail",
  "version": "0.7.0",
  "description": "Domain Modeling DSL — type-checkable domain models shared by humans and AI",
  "license": "MIT",
  "author": "hisamekms",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hisamekms/domaintrail.git"
  },
  "homepage": "https://github.com/hisamekms/domaintrail#readme",
  "bugs": {
    "url": "https://github.com/hisamekms/domaintrail/issues"
  },
  "keywords": [
    "ddd",
    "domain-driven-design",
    "domain-modeling",
    "dsl",
    "typescript",
    "codegen"
  ],
  "type": "module",
  "bin": {
    "dt": "dist/dt.js",
    "domaintrail": "dist/dt.js"
  },
  "exports": {
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "CHANGELOG.md",
    "CHANGELOG.ja.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "contexts/*",
    "capabilities/*",
    "platform/*",
    "shared/*",
    "apps/*"
  ],
  "scripts": {
    "langium:generate": "langium generate --file contexts/modeling/langium-config.json && langium generate --file contexts/storming/langium-config.json",
    "build": "bun run langium:generate && bun ./scripts/build.ts",
    "typecheck": "bun check -p tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun test",
    "test:unit": "bun test ./contexts ./capabilities ./platform ./shared ./apps",
    "test:it": "bun test ./test",
    "dt": "bun ./bin/dt.ts",
    "tree-sitter": "bun ./scripts/tree-sitter.ts",
    "session:seed": "bun ./scripts/session-seed.ts",
    "site:dev": "bun run --cwd site dev",
    "site:build": "bun run --cwd site build",
    "site:shots": "bun run --cwd site shots",
    "site:examples": "bun run --cwd site examples:check",
    "version": "bun ./scripts/zed-version.ts && git add editors/zed && bun run langium:generate && bun ./bin/dt.ts generate ts && git add shared/kernel/src/generated contexts/modeling/src/generated contexts/collaboration/src/generated contexts/knowledge/src/generated",
    "prepack": "bun run build"
  },
  "dependencies": {
    "chokidar": "6.0.0",
    "commander": "15.0.0",
    "elkjs": "0.12.0",
    "ignore": "7.0.14",
    "langium": "4.4.0",
    "picomatch": "4.0.7",
    "vscode-languageserver": "10.1.2",
    "ws": "8.22.0"
  },
  "peerDependencies": {
    "fast-check": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "fast-check": {
      "optional": true
    }
  },
  "devDependencies": {
    "@domaintrail/agent": "workspace:*",
    "@domaintrail/analysis": "workspace:*",
    "@domaintrail/collaboration": "workspace:*",
    "@domaintrail/dt": "workspace:*",
    "@domaintrail/generation": "workspace:*",
    "@domaintrail/kernel": "workspace:*",
    "@domaintrail/knowledge": "workspace:*",
    "@domaintrail/modeling": "workspace:*",
    "@domaintrail/storming": "workspace:*",
    "@domaintrail/visualization": "workspace:*",
    "@domaintrail/web": "workspace:*",
    "@domaintrail/workspace": "workspace:*",
    "@types/bun": "^1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fast-check": "4.10.2",
    "langium-cli": "4.4.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vscode-jsonrpc": "10.0.0",
    "web-tree-sitter": "0.27.1"
  }
}
