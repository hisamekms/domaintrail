{
  "$schema": "../../schema/domaintrail.schema.json",
  // What Modeling publishes (ADR 0027): the model in model/, its TypeScript in src/generated (committed; Modeling's
  // domain imports its types only. test/modeling-contracts.test.ts fails when generating again gives a different
  // output)
  "sources": ["model/**/*.dt"],
  "generate": {
    "ts": {
      "out": "src/generated",
    },
  },
}
