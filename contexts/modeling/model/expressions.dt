context Modeling {
  /// The binary operators of expressions: `implies`, `or`, `and`, `==`, `!=`, `<`, `<=`, `>`, `>=`.
  enum BinaryOp { implies or and eq ne lt le gt ge coalesce add sub mul div }

  /// `all(collection, x => body)` and `any(collection, x => body)`.
  enum Quantifier { all any }
  /// The list methods with a lambda: `.map(x => e)`, `.filter(x => p)`, `.sum(x => e)` (`.sum()` of numbers).
  enum ListMethod { map filter sum }

  /// A case of `match`: the variant (or the aggregate's state or kind), the fields it binds by name, and its value.
  value MatchCaseModel {
    variant: String
    bindings: String[0..*]
    body: ExprModel
  }

  /// An element of a list literal: a value, or `...xs` (`spread`).
  value ListItem {
    spread: Bool
    value: ExprModel
  }

  /// An invariant or requirement expression as a tree (syntax only: names are resolved by whoever reads it, in the
  /// scope of the invariant or requirement). Numbers keep their sign; `pattern` is the regular expression exactly as
  /// written.
  union ExprModel by k {
    bool {
      value: Bool
    }
    int {
      value: Int
    }
    /// A decimal number as written.
    decimal {
      value: String
    }
    string {
      value: String
    }
    name {
      name: String
    }
    /// `receiver.member`, or `receiver?.member` (`optional`): absent when the receiver is absent.
    member {
      receiver: ExprModel
      member: String
      optional: Bool?
    }
    not {
      operand: ExprModel
    }
    binary {
      op: BinaryOp
      left: ExprModel
      right: ExprModel
    }
    /// `match (subject) { Variant { fields } => body, … }`: one case per variant of a union, each once; over the
    /// aggregate (`this`, `before`, `after`), one case per state or per kind it can be in there.
    match {
      subject: ExprModel
      cases: MatchCaseModel[0..*]
    }
    /// `name(args)`: a call of a function of the context or of a shared context.
    call {
      name: String
      args: ExprModel[0..*]
    }
    /// `[a, b, ...xs]`.
    list {
      items: ListItem[0..*]
    }
    /// `collection.map(param => body)`, `.filter(…)`, `.sum(…)`; `.sum()` has no `param` and `body`.
    listMethod {
      method: ListMethod
      collection: ExprModel
      param: String?
      body: ExprModel?
    }
    /// `test ? then : else`.
    conditional {
      test: ExprModel
      ifTrue: ExprModel
      ifFalse: ExprModel
    }
    /// `operand in lower..upper`.
    range {
      operand: ExprModel
      lower: ExprModel
      upper: ExprModel
    }
    count {
      collection: ExprModel
    }
    exists {
      operand: ExprModel
    }
    length {
      operand: ExprModel
    }
    matches {
      operand: ExprModel
      pattern: String
    }
    round {
      operand: ExprModel
      scale: ExprModel
    }
    /// `unique(collection)`, or `unique(collection, x => key, …)`.
    unique {
      collection: ExprModel
      param: String?
      keys: ExprModel[0..*]
    }
    contains {
      collection: ExprModel
      element: ExprModel
    }
    quantifier {
      quantifier: Quantifier
      collection: ExprModel
      param: String
      body: ExprModel
    }
  }
}
