context Collaboration {
  /// エージェント実行の識別子。
  id AgentRunId "エージェント実行ID": UUID

  /// 実行が失敗した理由。
  enum FailureReason "失敗の理由" {
    RuleNotMet "成功の条件を満たさない"
    AgentError "エージェントの異常終了"
    LeaseExpired "応答の途絶"
    Interrupted "中断"
    ReadScopeTooLarge "読み取り範囲の除外が多すぎる"
  }

  /// 実行のあとの `dt fmt` / `dt check` の結果。ファイルが変わらなかった実行は省く。
  enum ToolOutcome "dt の工程の結果" { Ran "実行した" Failed "失敗した" Skipped "変更がなく省いた" }

  /// エージェントの実行のあとに、実行パイプラインが集めた事実。
  value RunReport "実行の報告" {
    exitCode: Int "終了コード"
    formatted: ToolOutcome "dt fmt"
    checked: ToolOutcome "dt check"
    newDtErrors: Tally "基準リビジョンより増えた .dt のエラー"
    unparsedDtes: Tally "構文解析できない .dtes"
  }

  /// 登録のときに写し取った依頼。あとで依頼が見送られても、実行の入力は変わらない。
  value FrozenRequest "凍結した依頼" {
    request: RequestId
    author: ParticipantId "依頼者"
    targets: TargetSnapshot[0..20] "対象"
    body: Text "本文"
    /// 依頼が返信した相手。実行なら、エージェントにその実行の依頼・返答・変更を前の実行として渡す。
    /// メッセージなら、その依頼者と本文を引いて渡す。
    replyTo: FrozenReplyTarget? "返信先"
    /// 打ち消しの依頼なら、変更を打ち消す実行。エージェントには、その実行の依頼・返答・ファイルごとの差分を渡す。
    reverts: AgentRunId? "打ち消す実行"
    /// 送ったときに依頼者が見ていたビュー。エージェントには「ここ」が指すところとして渡す。
    viewedAt: ViewedAt? "送ったときのビュー"
  }

  /// 登録のときに写し取った、依頼の返信先。メッセージへの返信は、そのときの依頼者と本文を写し取る。
  union FrozenReplyTarget "凍結した返信先" {
    /// AI の実行への返信。
    Run "実行" {
      run: AgentRunId "実行"
    }
    /// メッセージへの返信。
    Message "メッセージ" {
      request: RequestId "メッセージ"
      author: ParticipantId "依頼者"
      body: Text "本文"
    }
  }

  /// 登録のときに凍結した、実行の入力。束ねた依頼（依頼と実行の多対多）はここにある。
  value RunInput "実行の入力" {
    requests: FrozenRequest[1..*] "依頼"
    note: Text? "ファシリテーターの補足"
    answer: Answer? "前の実行の問いへの回答"
    pick: AlternativePick? "前の実行の前提で選んだ別案"
    /// ファシリテーターがまとめて承認した変更案。エージェントは承認した文に従う。
    proposals: ApprovedProposals? "承認した変更案"
    /// 始めた人が確定した聞き取りの要約。エージェントは要約を行き先の説明として書く。
    brief: BriefInstruction? "聞き取りの要約"
    /// 始めた人が候補型の `/` コマンドで採用した候補。エージェントは候補をコマンドの規則に従って反映する。
    candidates: CandidatesInstruction? "採用した候補"

    invariant distinctRequests "依頼は1件1回" { unique(requests, r => r.request) }
    invariant proposalsOfRequests "変更案は束ねた依頼のもの" {
      exists(proposals) implies all(proposals.approved, p => any(requests, r => r.request == p.request))
    }
  }

  /// エージェントの返答の中で、問いや選択肢を指す短いキー（英数字と `_` `-`）。長さの上限は返答の上限（コード）が決める。
  primitive ReplyKey "返答のキー": String { matches(value, "^[A-Za-z0-9_-]+$") }

  /// 依頼ごとの、エージェントの申告。事実（成否・変わったファイル）ではない。
  enum RequestProgress "依頼の進み具合" {
    Done "対応した"
    Partial "一部だけ対応した"
    Skipped "対応しなかった"
    Question "問いがある"
    /// 依頼でなく問いだと判じて、ファイルを変えずに答えた（返答の `answer`）。
    Answered "問いとして答えた"
  }

  /// 依頼1件についての返答。
  value RequestReply "依頼ごとの返答" {
    request: RequestId "依頼"
    status: RequestProgress "進み具合"
    note: Text? "補足"

    /// 一部だけ・対応しなかった依頼には、そのわけを添える。
    invariant noteExplains "一部と未対応には補足がある" {
      (status == RequestProgress.Partial or status == RequestProgress.Skipped) implies exists(note)
    }
  }

  /// 問いの選択肢。「その他（自由記述）」は画面がいつも足すので、ここには含めない。
  value ReplyOption "選択肢" {
    id: ReplyKey
    label: Text "ラベル"
    detail: Text? "説明"
  }

  /// エージェントがファシリテーターに選んでもらう問い。
  value ReplyQuestion "問い" {
    id: ReplyKey
    text: Text "問い"
    requests: RequestId[0..*] "関係する依頼"
    options: ReplyOption[0..*] "選択肢"
    multiple: Bool "複数選べる"

    invariant distinctOptions "選択肢のキーは1回" { unique(options, o => o.id) }
  }

  /// 前提の代わりにあり得た選択。
  value ReplyAlternative "別の選択" {
    id: ReplyKey
    label: Text "ラベル"
  }

  /// 依頼があいまいだったところで、エージェントが置いた前提。
  value ReplyAssumption "前提" {
    text: Text "前提"
    requests: RequestId[0..*] "関係する依頼"
    alternatives: ReplyAlternative[0..*] "別の選択"

    invariant distinctAlternatives "別の選択のキーは1回" { unique(alternatives, a => a.id) }
  }

  /// エージェントの返答を検証したもの。AI の申告で、信頼しない入力として上限とともに検証してから持つ。件数と長さの上限は
  /// コードの1か所（`domain/reply.ts`）にある。
  value AgentReply "エージェントの返答" {
    /// 依頼が何についてかを短く名付けたもの。続きの実行の題は使わず、ひとまとまりの最初の題がまとまりの題になる。
    /// 前からの返答にはない。
    title: Text? "題"
    summary: Text "要約"
    requests: RequestReply[0..*] "依頼ごとの返答"
    questions: ReplyQuestion[0..*] "問い"
    assumptions: ReplyAssumption[0..*] "前提"
    /// 依頼が問いだったときの答え（上限はコードの `REPLY_LIMITS.answer`）。問いとして答えた依頼があれば、ある。
    answer: Text? "回答"

    invariant distinctRequests "依頼は1件1回" { unique(requests, r => r.request) }
    invariant distinctQuestions "問いのキーは1回" { unique(questions, q => q.id) }
    invariant answeredHasAnswer "問いとして答えた依頼には回答がある" {
      any(requests, r => r.status == RequestProgress.Answered) implies exists(answer)
    }
  }

  /// ファシリテーターが選んだ、問い1つへの答え。登録のときに問いと選択肢を写し取る。
  value AnsweredQuestion "答えた問い" {
    question: ReplyKey "問い"
    text: Text "問いの文"
    chosen: ReplyOption[0..*] "選んだ選択肢"
    freeText: Text? "自由記述"

    invariant answered "選択か自由記述がある" { count(chosen) >= 1 or exists(freeText) }
    invariant distinctChosen "選択肢は1回" { unique(chosen, o => o.id) }
  }

  /// 確認待ちの実行の問いへの、ファシリテーターの回答。次の実行の入力に凍結する。
  value Answer "回答" {
    answerTo: AgentRunId "答える実行"
    answers: AnsweredQuestion[1..*] "答え"

    invariant distinctQuestions "問いは1回" { unique(answers, a => a.question) }
  }

  /// ファシリテーターが、完了した実行の前提の代わりに選んだ別案。その実行の依頼をそのまま束ねてやり直す実行の入力に凍結する。
  /// 前提は返答の中の番号（返答は保存したら変わらない）、別案はそのキーで指し、登録のときに前提の文と別案を写し取る。
  value AlternativePick "別案の選択" {
    pickOf: AgentRunId "選んだ実行"
    assumption: Tally "前提の番号"
    text: Text "前提"
    alternative: ReplyAlternative "選んだ別案"
  }

  /// 打ち消しを機械的にできず、AI に任せたわけ。
  union RevertObstacle "AI に任せたわけ" {
    /// あとの変更が、打ち消す実行の変更と重なる（大きすぎてマージできないファイルも）。
    Conflict "あとの変更と重なる" {
      paths: WorkspacePath[0..*] "重なるファイル"
    }
    /// 打ち消すと、いまのワークスペースにない .dt のエラーが出るか、構文解析できない .dtes ができる。
    Check "検査が通らない" {
      newDtErrors: Tally "増える .dt のエラー"
      unparsedDtes: WorkspacePath[0..*] "構文解析できない .dtes"
    }
    /// 打ち消す実行の前後のソースが、もう残っていない。
    Unreadable "前後の内容がない"
  }

  /// ファシリテーターが依頼を束ねて登録する、エージェントの1回の実行。実行は1つずつ順に行う。
  /// 作業の打ち消しの依頼も、ほかの依頼と同じく実行として待ちに入る。順が来ると、サーバーがまず機械的に打ち消し
  /// （エージェントを使わない。その記録が打ち消しの状態）、できなければエージェントに任せる。
  /// チャットでは、どちらも作業のひとまとまり（カード）になる。
  aggregate AgentRun "エージェント実行" {
    id: AgentRunId
    references session: SessionId -> Session
    owns input: RunInput "凍結した入力"
    queuedBy: ParticipantId "登録した人"
    queuedAt: Timestamp "登録日時"

    /// セッションの実行は1つずつ順に行う。実行キューのリース（ストア）が守る。
    invariant serial "セッションで実行中の実行は1つ"

    state Queued "待機中" {
      /// 打ち消しの実行で、サーバーが機械的に打ち消せず、エージェントに任せたわけ。打ち消しの実行でこれがないものは、
      /// まだサーバーが試していない: エージェントには渡さない（サーバーが先に試す）。
      revertObstacle: RevertObstacle? "AI に任せたわけ"
    }
    state Running "実行中" {
      baseRevision: RevisionId "基準リビジョン"
      startedAt: Timestamp "開始日時"
    }
    state Completed "完了" {
      baseRevision: RevisionId "基準リビジョン"
      startedAt: Timestamp "開始日時"
      report: RunReport "報告"
      resultRevision: RevisionId "結果リビジョン"
      changed: Bool "変更あり"
      reply: AgentReply? "エージェントの返答"
      finishedAt: Timestamp "終了日時"

      /// エージェントが 0 で終了し、基準リビジョンより .dt のエラーが増えず、すべての .dtes が構文解析でき、dt fmt と dt check が
      /// 失敗せず、ファイルを変えたなら両方を実行した（変えなかったなら省いてよい）。
      invariant succeeded "成功の条件を満たす" {
        report.exitCode == 0 and report.newDtErrors == 0 and report.unparsedDtes == 0 and report.formatted != ToolOutcome.Failed and report.checked != ToolOutcome.Failed and (changed == true implies (report.formatted == ToolOutcome.Ran and report.checked == ToolOutcome.Ran))
      }
      /// 何も変わらなかった実行の結果リビジョンは基準リビジョンそのもの。
      invariant unchangedKeepsBase "変更がなければ結果は基準リビジョン" {
        (changed == true implies resultRevision != baseRevision) and (changed == false implies resultRevision == baseRevision)
      }
      /// 完了の返答は問わない（問うなら確認待ち）。
      invariant completedAsksNothing "完了の返答に問いはない" { exists(reply) implies count(reply.questions) == 0 }
      /// 返答が挙げる依頼は、この実行の依頼。
      invariant completedReplyAboutInput "完了の返答の依頼は実行の依頼" {
        exists(reply) implies (all(reply.requests, r => any(input.requests, i => i.request == r.request)) and all(reply.questions, q => all(q.requests, x => any(input.requests, i => i.request == x))) and all(reply.assumptions, a => all(a.requests, x => any(input.requests, i => i.request == x))))
      }
    }
    /// エージェントが推測せずに問いを返した。ファイルはエージェントが残したまま（dt fmt / dt check は実行しない）。
    state NeedsClarification "確認待ち" {
      baseRevision: RevisionId "基準リビジョン"
      startedAt: Timestamp "開始日時"
      /// 問いの平文（構造のない返答、または構造化した問いを文にしたもの）。
      question: Text "問いかけ"
      reply: AgentReply? "エージェントの返答"
      resultRevision: RevisionId "結果リビジョン"
      finishedAt: Timestamp "終了日時"

      invariant clarificationAsks "確認待ちの返答には問いがある" { exists(reply) implies count(reply.questions) >= 1 }
      invariant clarificationReplyAboutInput "確認の返答の依頼は実行の依頼" {
        exists(reply) implies (all(reply.requests, r => any(input.requests, i => i.request == r.request)) and all(reply.questions, q => all(q.requests, x => any(input.requests, i => i.request == x))) and all(reply.assumptions, a => all(a.requests, x => any(input.requests, i => i.request == x))))
      }
    }
    /// エージェントが規則に反する・範囲外として依頼を断った。理由は返答の要約。dt fmt / dt check は実行しない。
    state Declined "辞退" {
      baseRevision: RevisionId "基準リビジョン"
      startedAt: Timestamp "開始日時"
      reply: AgentReply "エージェントの返答"
      resultRevision: RevisionId "結果リビジョン"
      finishedAt: Timestamp "終了日時"

      invariant declinedAsksNothing "辞退の返答に問いはない" { count(reply.questions) == 0 }
      invariant declinedReplyAboutInput "辞退の返答の依頼は実行の依頼" {
        (all(reply.requests, r => any(input.requests, i => i.request == r.request)) and all(reply.questions, q => all(q.requests, x => any(input.requests, i => i.request == x))) and all(reply.assumptions, a => all(a.requests, x => any(input.requests, i => i.request == x))))
      }
    }
    state Failed "失敗" {
      baseRevision: RevisionId "基準リビジョン"
      startedAt: Timestamp "開始日時"
      reason: FailureReason
      report: RunReport? "報告"
      resultRevision: RevisionId? "結果リビジョン"
      finishedAt: Timestamp "終了日時"

      invariant ruleNotMetReported "成功の条件を満たさないことが報告にある" {
        reason == FailureReason.RuleNotMet implies (exists(report) and exists(resultRevision) and not (report.exitCode == 0 and report.newDtErrors == 0 and report.unparsedDtes == 0 and report.formatted != ToolOutcome.Failed and report.checked != ToolOutcome.Failed and (resultRevision != baseRevision implies (report.formatted == ToolOutcome.Ran and report.checked == ToolOutcome.Ran))))
      }
    }
    state Cancelled "中止" {
      baseRevision: RevisionId? "基準リビジョン"
      cancelledBy: ParticipantId "中止した人"
      cancelledAt: Timestamp "中止日時"
    }
    /// エージェントを使わずに、ある実行の変更を機械的に打ち消した記録。順が来たときのワークスペースに、その実行の基準と
    /// 結果の差を逆向きに当て（3方向のマージ）、dt fmt と dt check で確かめて書いた。打ち消す前のワークスペースが基準
    /// リビジョン、打ち消した後が結果リビジョン。その実行の変更がもう残っていなければ、何も書かずに終わる（変更なし）。
    state Reverted "打ち消し" {
      baseRevision: RevisionId "基準リビジョン"
      resultRevision: RevisionId "結果リビジョン"
      changed: Bool "変更あり"
      finishedAt: Timestamp "終了日時"

      /// 何も変わらなかった打ち消し（打ち消すものが残っていなかった）の結果リビジョンは基準リビジョンそのもの。
      invariant revertKeepsBaseUnchanged "打ち消すものがなければ結果は基準リビジョン" {
        (changed == true implies resultRevision != baseRevision) and (changed == false implies resultRevision == baseRevision)
      }
      /// 機械的な打ち消しが束ねるのは、打ち消しの依頼だけ。
      invariant revertsRevertRequests "打ち消しの依頼を束ねる" { all(input.requests, r => exists(r.reverts)) }
    }

    /// 実行を登録するのはファシリテーター（問いへの回答と別案の選択も、登録の入力）。
    create command queue(id: AgentRunId, session: ActiveSession, requests: PendingRequest[1..*], input: RunInput, queuedBy: ParticipantId, queuedByRole: ParticipantRole, queuedAt: Timestamp) "実行を登録する"
      -> Queued
      requires facilitatorQueues "ファシリテーターが登録する" {
        queuedByRole == ParticipantRole.Facilitator
      } else FacilitatorOnly
      requires distinctRequests "依頼は1件1回" { unique(requests) } else DuplicateRequest
      requires inputCoversRequests "入力は束ねた依頼の写し" {
        count(input.requests) == count(requests) and all(requests, r => any(input.requests, i => i.request == r))
      } else InputMismatch
      emits RunQueued

    /// 順が来た打ち消しの実行を、サーバーがエージェントを使わずに機械的に打ち消した（または、打ち消すものがもうなかった）。
    command revert(baseRevision: RevisionId "基準リビジョン", resultRevision: RevisionId "結果リビジョン", changed: Bool "変更あり", finishedAt: Timestamp) "機械的に打ち消す"
      Queued -> Reverted
      requires inputReverts "入力は打ち消しの依頼" { all(input.requests, r => exists(r.reverts)) } else InputMismatch
      requires changedMatchesResult "変更の有無が結果リビジョンと合う" {
        (changed == true implies resultRevision != baseRevision) and (changed == false implies resultRevision == baseRevision)
      } else ChangedMismatch
      emits RunReverted

    /// 順が来た打ち消しの実行を、サーバーが機械的に打ち消せなかった: 待ちのまま、わけを添えてエージェントに任せる。
    command leaveToAgent(obstacle: RevertObstacle "わけ") "AI に任せる"
      Queued -> Queued
      requires inputReverts "入力は打ち消しの依頼" { all(input.requests, r => exists(r.reverts)) } else InputMismatch
      changes revertObstacle
      emits RevertLeftToAgent

    /// 開始の前に取ったワークスペースのスナップショットが基準リビジョンになる。
    command start(baseRevision: RevisionId, startedAt: Timestamp) "実行を始める"
      Queued -> Running
      emits RunStarted

    /// 報告が成功の条件を満たせば完了、満たさなければ失敗（RuleNotMet）。成功の条件は変更の有無による（変えなかった実行は
    /// dt fmt / dt check を省いてよい）。
    /// 返答は完了のときだけ残す（失敗は事実が決め、返答を見せない）。
    command finish(report: RunReport, resultRevision: RevisionId, changed: Bool, reply: AgentReply?, finishedAt: Timestamp) "実行を終える"
      Running -> Completed | Failed
      requires changedMatchesResult "変更の有無が結果リビジョンと合う" {
        (changed == true implies resultRevision != baseRevision) and (changed == false implies resultRevision == baseRevision)
      } else ChangedMismatch
      requires replyAsksNothing "完了の返答に問いはない" {
        exists(reply) implies count(reply.questions) == 0
      } else InvalidReply
      requires replyAboutInput "返答の依頼は実行の依頼" {
        exists(reply) implies (all(reply.requests, r => any(input.requests, i => i.request == r.request)) and all(reply.questions, q => all(q.requests, x => any(input.requests, i => i.request == x))) and all(reply.assumptions, a => all(a.requests, x => any(input.requests, i => i.request == x))))
      } else InvalidReply
      emits RunCompleted when -> Completed,
            RunFailed when -> Failed

    command askClarification(question: Text, reply: AgentReply?, resultRevision: RevisionId, finishedAt: Timestamp) "確認を求める"
      Running -> NeedsClarification
      requires replyAsks "確認待ちの返答には問いがある" {
        exists(reply) implies count(reply.questions) >= 1
      } else InvalidReply
      requires replyAboutInput "返答の依頼は実行の依頼" {
        exists(reply) implies (all(reply.requests, r => any(input.requests, i => i.request == r.request)) and all(reply.questions, q => all(q.requests, x => any(input.requests, i => i.request == x))) and all(reply.assumptions, a => all(a.requests, x => any(input.requests, i => i.request == x))))
      } else InvalidReply
      emits RunNeedsClarification

    /// エージェントが依頼を断った。ファイルを変えていても、事実（結果リビジョン）はそのまま残す。
    command decline(reply: AgentReply, resultRevision: RevisionId, finishedAt: Timestamp) "辞退する"
      Running -> Declined
      requires replyAsksNothing "辞退の返答に問いはない" { count(reply.questions) == 0 } else InvalidReply
      requires replyAboutInput "返答の依頼は実行の依頼" {
        (all(reply.requests, r => any(input.requests, i => i.request == r.request)) and all(reply.questions, q => all(q.requests, x => any(input.requests, i => i.request == x))) and all(reply.assumptions, a => all(a.requests, x => any(input.requests, i => i.request == x))))
      } else InvalidReply
      emits RunDeclined

    /// 報告の得られない失敗（エージェントの異常終了、応答の途絶、再起動による中断、除外が多すぎて読み取り範囲を守れない）。
    command fail(reason: FailureReason, finishedAt: Timestamp) "実行を失敗にする"
      Running -> Failed
      requires abnormal "報告のない失敗" { reason != FailureReason.RuleNotMet } else ReportRequired
      emits RunFailed

    /// 中止するのはファシリテーター。
    command cancel(cancelledBy: ParticipantId, cancelledByRole: ParticipantRole, cancelledAt: Timestamp) "実行を中止する"
      Queued | Running -> Cancelled
      requires facilitatorCancels "ファシリテーターが中止する" {
        cancelledByRole == ParticipantRole.Facilitator
      } else FacilitatorOnly
      emits RunCancelled
  }

  persistent event RunQueued "実行登録" {
    runId: AgentRunId
    session: SessionId
    requests: RequestId[1..*]
    queuedBy: ParticipantId
    queuedAt: Timestamp
  }

  persistent event RunReverted "打ち消し" {
    runId: AgentRunId
    baseRevision: RevisionId "基準リビジョン"
    resultRevision: RevisionId "結果リビジョン"
    changed: Bool "変更あり"
    finishedAt: Timestamp
  }

  persistent event RevertLeftToAgent "AI に任せた打ち消し" {
    runId: AgentRunId
    obstacle: RevertObstacle "わけ"
  }

  persistent event RunStarted "実行開始" {
    runId: AgentRunId
    baseRevision: RevisionId
    startedAt: Timestamp
  }

  persistent event RunCompleted "実行完了" {
    runId: AgentRunId
    resultRevision: RevisionId
    changed: Bool
    finishedAt: Timestamp
  }

  persistent event RunNeedsClarification "確認依頼" {
    runId: AgentRunId
    question: Text
    resultRevision: RevisionId
    finishedAt: Timestamp
  }

  persistent event RunDeclined "実行辞退" {
    runId: AgentRunId
    resultRevision: RevisionId
    finishedAt: Timestamp
  }

  persistent event RunFailed "実行失敗" {
    runId: AgentRunId
    reason: FailureReason
    finishedAt: Timestamp
  }

  persistent event RunCancelled "実行中止" {
    runId: AgentRunId
    cancelledBy: ParticipantId
    cancelledAt: Timestamp
  }

  /// 同じ依頼を2回束ねた。
  error DuplicateRequest "依頼の重複"

  /// 凍結した入力が、束ねた依頼と合わない。
  error InputMismatch "入力の不一致"

  /// 変更ありなのに結果が基準リビジョンのまま、または変更なしなのに結果が基準リビジョンと違う。
  error ChangedMismatch "変更の有無の不一致"

  /// 成功の条件を満たさない失敗は、報告とともに finish で終える。
  error ReportRequired "報告が必要"

  /// 別案を選んだ実行は、完了していないか、返答に前提がない（別案を選べるのは前提のある完了の実行）。
  error RunNotPickable "別案を選べない実行" {
    run: AgentRunId
  }

  /// 選んだ前提の番号または別案のキーが、その実行の返答にない。
  error AlternativeNotFound "返答にない別案" {
    run: AgentRunId
  }

  /// 別案を選んでやり直す実行の依頼が、選んだ実行の依頼と同じでない。
  error PickMismatch "選んだ実行と依頼の不一致" {
    run: AgentRunId
  }

  /// エージェントの返答が、終わり方（完了・確認待ち・辞退）や実行の依頼と合わない。
  error InvalidReply "返答の不整合"
}
