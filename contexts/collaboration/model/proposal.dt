context Collaboration {
  /// 変更案の識別子。
  id ChangeProposalId "変更案ID": UUID

  /// 変更案の文。項目ごとの上限はコード（`domain/proposals.ts` の `PROPOSAL_LIMITS`）が決める。
  primitive ProposalText "変更案の文": String { length(value) >= 1 and length(value) <= 2000 }

  /// 変更案の中身: 何を、どこを（要素は `#名前` で）、どう変えるか。差分の見本はまだない。
  value ProposalContent "変更案の中身" {
    what: ProposalText "何を"
    where: ProposalText "どこを"
    how: ProposalText "どう"
  }

  /// 実行の入力に凍結した、承認した変更案1つ（ファシリテーターが編集したなら、その文）。
  value ApprovedProposal "承認した変更案" {
    proposal: ChangeProposalId "変更案"
    request: RequestId "元のメッセージ"
    content: ProposalContent "承認した文"
  }

  /// まとめて承認した変更案。まとめて承認したものは1つの実行になる。
  value ApprovedProposals "承認した変更案の組" {
    approved: ApprovedProposal[1..*] "変更案"

    invariant distinctProposals "変更案は1回" { unique(approved, p => p.proposal) }
  }

  /// 参加者の変更依頼について、回答役（読むだけの AI）が書いた変更案。ファシリテーターが承認（編集してもよい）か却下し、
  /// 依頼した参加者は承認待ちのあいだ取り下げられる。承認した変更案は、ふつうの実行として待ちに入る（まとめて承認したものは
  /// 1つの実行）。
  aggregate ChangeProposal "変更案" {
    id: ChangeProposalId
    references session: SessionId -> Session
    references triage: TriageId -> Triage "仕分け"
    references request: RequestId -> Request "元のメッセージ"
    requestedBy: ParticipantId "依頼した人"
    owns content: ProposalContent "変更案"
    proposedAt: Timestamp "提案日時"

    state Open "承認待ち"
    state Approved "承認済み" {
      approvedBy: ParticipantId "承認した人"
      approvedAt: Timestamp "承認日時"
      /// ファシリテーターが編集して承認したなら、その文（実行はこちらに従う）。
      edited: ProposalContent? "編集した変更案"
      references run: AgentRunId -> AgentRun "実行"
    }
    state Rejected "却下" {
      rejectedBy: ParticipantId "却下した人"
      rejectedAt: Timestamp "却下日時"
      /// 依頼した人へのひとこと。
      note: Text? "ひとこと"
    }
    state Withdrawn "取り下げ" {
      withdrawnAt: Timestamp "取り下げ日時"
    }

    /// 回答役が、参加者の変更依頼について変更案を書く。
    create command propose(id: ChangeProposalId, session: ActiveSession, triage: ProposableTriage, request: RequestId, requestedBy: ParticipantId, content: ProposalContent, proposedAt: Timestamp) "変更案を書く"
      -> Open
      emits ChangeProposed

    /// ファシリテーターが承認する（編集してもよい）。実行の登録と同じ取引で、その実行を記録する。
    command approve(approvedBy: ParticipantId, approvedByRole: ParticipantRole, edited: ProposalContent?, run: AgentRunId, approvedAt: Timestamp) "変更案を承認する"
      Open -> Approved
      requires facilitatorApproves "ファシリテーターが承認する" {
        approvedByRole == ParticipantRole.Facilitator
      } else FacilitatorOnly
      emits ProposalApproved

    /// ファシリテーターが却下する（ひとことを添えてもよい）。
    command reject(rejectedBy: ParticipantId, rejectedByRole: ParticipantRole, note: Text?, rejectedAt: Timestamp) "変更案を却下する"
      Open -> Rejected
      requires facilitatorRejects "ファシリテーターが却下する" {
        rejectedByRole == ParticipantRole.Facilitator
      } else FacilitatorOnly
      emits ProposalRejected

    /// 依頼した参加者が、承認待ちのあいだに取り下げる。
    command withdraw(withdrawnBy: ParticipantId, withdrawnAt: Timestamp) "変更案を取り下げる"
      Open -> Withdrawn
      requires requesterWithdraws "依頼した人が取り下げる" { withdrawnBy == requestedBy } else NotTheRequester
      emits ProposalWithdrawn
  }

  persistent event ChangeProposed "変更案の提案" {
    proposalId: ChangeProposalId
    session: SessionId
    triage: TriageId
    request: RequestId
    requestedBy: ParticipantId
    content: ProposalContent
    proposedAt: Timestamp
  }

  persistent event ProposalApproved "変更案の承認" {
    proposalId: ChangeProposalId
    approvedBy: ParticipantId
    edited: ProposalContent? "編集した変更案"
    run: AgentRunId
    approvedAt: Timestamp
  }

  persistent event ProposalRejected "変更案の却下" {
    proposalId: ChangeProposalId
    rejectedBy: ParticipantId
    note: Text? "ひとこと"
    rejectedAt: Timestamp
  }

  persistent event ProposalWithdrawn "変更案の取り下げ" {
    proposalId: ChangeProposalId
    withdrawnBy: ParticipantId
    withdrawnAt: Timestamp
  }

  /// 変更案を取り下げられるのは、依頼した参加者だけ。
  error NotTheRequester "依頼した人でない"
}
