/**
 * The invariants of Quantity that a value violates, in declaration order; empty when it is a Quantity.
 * @see sales/order.dt:7
 */
export function checkQuantity(value: number): readonly InvalidQuantity['invariant'][] {
    const violated: InvalidQuantity['invariant'][] = [];
    if (!(1 <= value && value <= 999)) violated.push('valid');
    return violated;
}

/**
 * Creates a Quantity, checking its invariants with \`checkQuantity\`: the first one violated is reported.
 * @see sales/order.dt:7
 */
export const makeQuantity: MakeQuantity = (value) => {
    const [invariant] = checkQuantity(value);
    if (invariant === undefined) return ok(value as Quantity);
    return err({ type: 'InvalidQuantity', value, invariant });
};

/**
 * 商品コード
 * 英大文字3桁-数字4桁の商品コード。
