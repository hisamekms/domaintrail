    return violated;
}

/**
 * Creates a OrderItemId, checking its invariants with \`checkOrderItemId\`: the first one violated is reported.
 * @see sales/order.dt:3
 */
export const makeOrderItemId: MakeOrderItemId = (value) => {
    const [invariant] = checkOrderItemId(value);
    if (invariant === undefined) return ok(value as OrderItemId);
    return err({ type: 'InvalidOrderItemId', value, invariant });
};

/**
 * 取消理由
 * @see sales/order.dt:5
 */
