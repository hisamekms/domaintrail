 * A value that violates an invariant of Quantity.
 * @see sales/order.dt:7
 */
export interface InvalidQuantity {
    readonly type: 'InvalidQuantity';
    readonly value: number;
    /** The violated invariant. */
    readonly invariant: 'valid';
}

/**
 * Creates a Quantity, checking its invariants: generated as \`makeQuantity\`, or written by hand.
 * @see sales/order.dt:7
 */
export type MakeQuantity = (value: number) => Result<Quantity, InvalidQuantity>;

/**
 * The invariants of Quantity that a value violates, in declaration order; empty when it is a Quantity.
 * @see sales/order.dt:7
 */
export function checkQuantity(value: number): readonly InvalidQuantity['invariant'][] {
    const violated: InvalidQuantity['invariant'][] = [];
    if (!(1 <= value && value <= 999)) violated.push('valid');
    return violated;
}

