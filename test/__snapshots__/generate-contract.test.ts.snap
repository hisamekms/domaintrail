 * an event the outcome does not emit "'X' does not exist in type …". Elsewhere, pass the type: \`ok<T>(value)\`.
 */
export const ok = <T>(value: NoInfer<T>): Ok<T> => ({ ok: true, value });
export const err = <E>(error: E): Err<E> => ({ ok: false, error });

/** The events of an outcome that emits none: only \`{}\` is assignable. */
export type NoEvents = { readonly [type: string]: never };

/** The outcome of a command's success value \`{ [state]: { aggregate, events } }\`, with its key as \`to\`. */
export type Outcome<V> = V extends unknown
    ? NonNullable<{ [K in keyof V]: V[K] extends { readonly aggregate: infer A; readonly events: infer E } ? { readonly to: K; readonly aggregate: A; readonly events: E } : never }[keyof V]>
    : never;

type Flat<T> = T extends readonly (infer X)[] ? X : T;
/** The events held by the \`events\` of an outcome, as one union. */
export type EventOf<E> = E extends unknown ? { [K in keyof E]-?: Flat<NonNullable<E[K]>> }[keyof E] : never;

/**
 * The outcome of a command's success value as \`{ to, aggregate, events }\`, for code that handles any command (save the
 * aggregate, publish the events). \`to\` is the key of the outcome: the target state, or the aggregate's name without states.
 */
export const outcome = <V extends object>(value: V): Outcome<V> => {
    const [to, o] = Object.entries(value).find(([, v]) => v !== undefined) as [string, { aggregate: unknown; events: unknown }];
    return { to, aggregate: o.aggregate, events: o.events } as Outcome<V>;
};

/**
 * The events of an outcome as one flat list: arrays are flattened and absent optional events skipped. The contract
 * gives the events of one command no order; this list is sorted by event type, then in the order of each array.
 */
export const eventList = <E extends object>(events: E): readonly EventOf<E>[] =>
    Object.keys(events)
        .sort()
        .flatMap((type) => {
            const v = (events as Record<string, unknown>)[type];
            return v === undefined ? [] : Array.isArray(v) ? v : [v];
        }) as EventOf<E>[];

declare const nothing: unique symbol;
/** The \`set\` of an outcome that gives no field: only \`{}\` is assignable ("'x' does not exist in type 'NoChanges'"). */
export type NoChanges = { readonly [nothing]?: never };

/**
 * The fields of an aggregate, as data for \`decide\`: its common fields (all its fields without states), and the fields
 * each state has on top of them.
 */
export interface Shape {
    readonly fields: readonly string[];
    readonly states?: { readonly [state: string]: readonly string[] };
}

type ArgsAfterFirst<F> = F extends (first: any, ...args: infer A) => unknown ? A : never;
/** The aggregate an outcome makes: the input's fields that \`set\` does not give, the target state, and \`set\`. */
type Made<From, To, Set> = (From extends object ? Omit<From, 'state' | keyof Set> : {}) & { readonly state: To } & Set;
/** A decision's result as the command's: each outcome's \`set\` replaced by the aggregate it makes. */
type TargetOf<K, Targets> = K extends keyof Targets ? Targets[K] : K;
type Decided<R, From, Targets = {}> = R extends Ok<infer V>
    ? Ok<V extends unknown ? { readonly [K in keyof V]: [V[K]] extends [never] ? never : V[K] extends { readonly set: infer S; readonly events: infer E } ? { readonly aggregate: Made<From, TargetOf<K, Targets>, S>; readonly events: E } : V[K] } : never>
    : R;
type DecidedBy<F, Targets = {}> = F extends (...args: infer A) => infer R ? Decided<R, A[0], Targets> : never;

/** The command \`decide\` makes of a decision: assignable to the command's contract. */
export type Decide<D, Targets = {}> = D extends (...args: any[]) => unknown
    ? (...args: Parameters<D>) => DecidedBy<D, Targets>
    : <S extends { readonly state: keyof D }>(subject: S, ...args: ArgsAfterFirst<D[keyof D]>) => { [K in keyof D]: DecidedBy<D[K], Targets> }[S['state']];

/**
 * Implements a command from its decision (a generated \`<Command><Aggregate>Decision\`): one handler per source state,
 * or one function for a factory and for an aggregate without states. The result calls the handler of the input's
 * \`state\` with the same arguments; an error passes through unchanged. Each outcome's aggregate is made from the
 * shape: the fields \`set\` gives, the other fields of the target state from the input (common fields, and the
 * state-specific fields carried over), and the target \`state\`. The input's other fields are dropped. Events
 * pass through.
 *
 *     confirm: decide<Sales.ConfirmOrderDecision>(Sales.OrderShape, { Draft: (order, at) => ok({ Confirmed: { set: …, events: … } }) })
 */
export interface ChoiceVerifier {
    readonly applicable: (...args: readonly unknown[]) => readonly string[];
    readonly choices: (...args: readonly unknown[]) => Readonly<Record<string, boolean>>;
}

export const decide = <D>(shape: Shape, decision: D, targets: Readonly<Record<string, string>> = {}, verify?: ChoiceVerifier): Decide<D> =>
    ((...args: any[]) => {
        const subject = args[0];
        const handler = (typeof decision === 'function' ? decision : (decision as any)[subject.state]) as (...args: any[]) => Result<object, unknown>;
        const r = handler(...args);
        if (!r.ok) return r;
        if (verify) {
            const names = verify.applicable(...args);
            const choices = verify.choices(...args);
            const selected = Object.keys(r.value as object).filter((name) => (r.value as Record<string, unknown>)[name] !== undefined);
            const trueNames = names.filter((name) => choices[name]);
            const selectedName = selected[0];
            if (selectedName === undefined || selected.length !== 1 || !names.includes(selectedName) || trueNames.length !== 1 || trueNames[0] !== selectedName)
                throw new Error('DomainTrail choice contract violated: expected exactly one applicable selected outcome.');
        }
        const value: Record<string, unknown> = {};
        for (const [name, o] of Object.entries(r.value as Record<string, { set: Record<string, unknown>; events: unknown } | undefined>)) {
            if (o === undefined) continue;
            const to = targets[name] ?? name;
            const aggregate: Record<string, unknown> = shape.states ? { state: to } : {};
            for (const f of [...shape.fields, ...(shape.states?.[to] ?? [])]) {
                const v = f in o.set ? o.set[f] : subject?.[f];
                if (v !== undefined) aggregate[f] = v;
            }
            value[name] = { aggregate, events: o.events };
        }
        return { ok: true, value };
    }) as Decide<D>;

/** Construct a named-outcome command from a decision and its outcome-to-state map. */
export const decideNamed = <D>() => <const Targets extends Readonly<Record<string, string>>>(
    shape: Shape,
    targets: Targets,
    decision: D,
    verify?: ChoiceVerifier,
): Decide<D, Targets> => decide(shape, decision, targets, verify) as Decide<D, Targets>;

/** Whether two optional values are equal: both absent, or both present and equal by \`same\` (for generated checks). */
export const sameOptional = <T>(a: T | undefined, b: T | undefined, same: (x: T, y: T) => boolean): boolean =>
    a === undefined || b === undefined ? a === b : same(a, b);

/** Whether two lists are equal: the same length, and equal by \`same\` element by element (for generated checks). */
export const sameList = <T>(a: readonly T[], b: readonly T[], same: (x: T, y: T) => boolean): boolean =>
    a.length === b.length && a.every((x, i) => same(x, b[i]!));

/** Whether no two elements of a list are equal by \`same\`: \`unique(…)\` of the DSL (for generated checks). */
export const distinct = <T>(xs: readonly T[], same: (x: T, y: T) => boolean): boolean =>
    xs.every((x, i) => xs.every((y, j) => j <= i || !same(x, y)));

/**
 * Decimal values are carried as strings so that no precision is lost. Make one with \`parseDecimal\`; never
 * \`as Decimal\` (see dt guide lint).
 */
export type Decimal = string & { readonly __brand: 'Decimal' };

/**
 * The text as a \`Decimal\`, or \`undefined\` when it is not one: digits with an optional leading \`-\` and an optional
 * fraction (\`"1200"\`, \`"-3"\`, \`"12.50"\`). No \`+\`, exponent, grouping or spaces; \`".5"\` and \`"5."\` are not decimals.
 * The text is kept as it is (\`"12.50"\` stays \`"12.50"\`). The one place that makes a \`Decimal\` from a string.
 */
export const parseDecimal = (text: string): Decimal | undefined => (/^-?\\d+(\\.\\d+)?$/.test(text) ? (text as Decimal) : undefined);

/** Exact comparison of two decimal strings, without conversion to IEEE-754 numbers. */
export function decimalCompare(a: string, b: string): -1 | 0 | 1 {
    const parts = (v: string) => {
        const negative = v.startsWith('-');
        const [whole, fraction = ''] = (negative ? v.slice(1) : v).split('.');
        return { negative, whole: (whole ?? '').replace(/^0+/, '') || '0', fraction: fraction.replace(/0+$/, '') };
    };
    const x = parts(a), y = parts(b);
    const zero = (v: typeof x) => v.whole === '0' && v.fraction === '';
    if (zero(x) && zero(y)) return 0;
    if (x.negative !== y.negative) return x.negative ? -1 : 1;
    const fractionLength = Math.max(x.fraction.length, y.fraction.length);
    const xf = x.fraction.padEnd(fractionLength, '0');
    const yf = y.fraction.padEnd(fractionLength, '0');
    const magnitude = x.whole.length === y.whole.length
        ? x.whole === y.whole
            ? (xf < yf ? -1 : xf > yf ? 1 : 0)
            : x.whole < y.whole ? -1 : 1
        : x.whole.length < y.whole.length ? -1 : 1;
    return (x.negative ? -magnitude : magnitude) as -1 | 0 | 1;
}

/** Point in time. */
export type Timestamp = Date;
"
`;

