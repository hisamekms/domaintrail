export function checkOrder(order: Order): readonly ('quantitiesPositive' | 'distinctSkus' | 'singleCurrency' | 'hasItems' | 'otherNeedsNote')[] {
    switch (order.state) {
        case 'Draft': return checkDraftOrder(order);
        case 'Confirmed': return checkConfirmedOrder(order);
        case 'Cancelled': return checkCancelledOrder(order);
    }
}

