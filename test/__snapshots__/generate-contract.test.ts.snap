}

/**
 * The invariants of Order in state Confirmed (the aggregate's, by \`checkOrderCommon\`, and the state's) that an aggregate violates, in declaration order.
 * @see sales/order.dt:32
 */
export function checkConfirmedOrder(order: ConfirmedOrder): readonly ('quantitiesPositive' | 'distinctSkus' | 'singleCurrency' | 'hasItems')[] {
    const violated: ('quantitiesPositive' | 'distinctSkus' | 'singleCurrency' | 'hasItems')[] = [...checkOrderCommon(order)];
    if (!(order.items.length > 0)) violated.push('hasItems');
    return violated;
}

/**
 * The invariants of Order in state Cancelled (the aggregate's, by \`checkOrderCommon\`, and the state's) that an aggregate violates, in declaration order.
 * @see sales/order.dt:37
 */
export function checkCancelledOrder(order: CancelledOrder): readonly ('quantitiesPositive' | 'distinctSkus' | 'singleCurrency' | 'otherNeedsNote')[] {
    const violated: ('quantitiesPositive' | 'distinctSkus' | 'singleCurrency' | 'otherNeedsNote')[] = [...checkOrderCommon(order)];
    if (order.reason === 'Other' && !(order.note !== undefined)) violated.push('otherNeedsNote');
    return violated;
}

/**
 * The invariants of Order in the state it is in that an aggregate violates (see the check of each state).
 * @see sales/order.dt:13
 */
export function checkOrder(order: Order): readonly ('quantitiesPositive' | 'distinctSkus' | 'singleCurrency' | 'hasItems' | 'otherNeedsNote')[] {
    switch (order.state) {
        case 'Draft': return checkDraftOrder(order);
        case 'Confirmed': return checkConfirmedOrder(order);
        case 'Cancelled': return checkCancelledOrder(order);
    }
}

