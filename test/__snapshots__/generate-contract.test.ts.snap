/**
 * The invariants of OrderItemId that a value violates, in declaration order after 'uuid'; empty when it is a OrderItemId.
 * @see sales/order.dt:3
 */
export function checkOrderItemId(value: string): readonly InvalidOrderItemId['invariant'][] {
