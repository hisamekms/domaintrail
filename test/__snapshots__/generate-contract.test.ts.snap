export interface Generation extends testing.RunOptions {
    /** Arbitraries replacing the generated ones, by context and type (still filtered by the invariants). */
    readonly arbitraries?: { readonly Billing?: Partial<BillingTests.Arbitraries>; readonly Common?: Partial<CommonTests.Arbitraries>; readonly Sales?: Partial<Arbitraries> };
    /** Checks of the constraints without an expression, by context; those not given are not tested. */
    readonly declared?: { readonly Billing?: BillingTests.DeclaredChecks; readonly Common?: CommonTests.DeclaredChecks; readonly Sales?: DeclaredChecks };
}

export interface Options extends Generation {
    readonly examples?: Examples;
}

/** What \`contract\` tests: the constructors of domain primitives and the commands of aggregates, each optional. */
export interface Implementation {
    readonly make?: { readonly CustomerId?: Sales.MakeCustomerId; readonly OrderId?: Sales.MakeOrderId; readonly OrderItemId?: Sales.MakeOrderItemId; readonly Quantity?: Sales.MakeQuantity; readonly Sku?: Sales.MakeSku };
    readonly Customer?: Sales.CustomerCommands;
    readonly Order?: Sales.OrderCommands;
}

/** The arbitraries of Sales, with the overrides, declared checks and examples of the options. */
export function arbitraries(options: Omit<Partial<Options>, 'declared'> & Pick<Generation, 'declared'> = {}): Arbitraries {
    const seed = options.seed ?? testing.DEFAULT_SEED;
    const given: Partial<Arbitraries> = options.arbitraries?.Sales ?? {};
    const scalar = testing.scalars(options.seed ?? testing.DEFAULT_SEED);
    const generation: Generation = { ...(options.seed !== undefined && { seed: options.seed }), ...(options.arbitraries && { arbitraries: options.arbitraries }), ...(options.declared && { declared: options.declared }) };
    let CommonOf: CommonTests.Arbitraries | undefined;
    const CommonArbs = (): CommonTests.Arbitraries => (CommonOf ??= CommonTests.arbitraries(generation));
    const a: Arbitraries = testing.lazy<Arbitraries>({
        CustomerId: () => testing.valid(given.CustomerId ?? testing.collide(testing.cast<Sales.CustomerId>(testing.base('UUID', {})), seed), (v) => Sales.checkCustomerId(v).length === 0, 'Sales.CustomerId'),
        AvailableEmail: () => given.AvailableEmail ?? testing.cast<Sales.AvailableEmail>(CommonArbs().EmailAddress),
        Customer: () => testing.withExamples(given.Customer ?? testing.cast<Sales.Customer>(fc.record({ id: a.CustomerId, name: testing.cast<string>(scalar.String), email: CommonArbs().EmailAddress })), options.examples?.Customer?.aggregates, () => [], 'Sales.Customer'),
        CustomerRegistered: () => given.CustomerRegistered ?? testing.cast<Sales.CustomerRegistered>(fc.record({ type: fc.constant('CustomerRegistered' as const), customerId: a.CustomerId })),
        OrderId: () => testing.valid(given.OrderId ?? testing.collide(testing.cast<Sales.OrderId>(testing.base('UUID', {})), seed), (v) => Sales.checkOrderId(v).length === 0, 'Sales.OrderId'),
        OrderItemId: () => testing.valid(given.OrderItemId ?? testing.collide(testing.cast<Sales.OrderItemId>(testing.base('UUID', {})), seed), (v) => Sales.checkOrderItemId(v).length === 0, 'Sales.OrderItemId'),
        CancelReason: () => given.CancelReason ?? fc.constantFrom<Sales.CancelReason>('Requested', 'Other'),
        Quantity: () => testing.valid(given.Quantity ?? testing.collide(testing.cast<Sales.Quantity>(testing.base('Int', { ge: 1, le: 999 })), seed), (v) => Sales.checkQuantity(v).length === 0, 'Sales.Quantity'),
        Sku: () => testing.valid(given.Sku ?? testing.collide(testing.cast<Sales.Sku>(testing.base('String', { pattern: '^[A-Z]{3}-\\\\d{4}$' })), seed), (v) => Sales.checkSku(v).length === 0, 'Sales.Sku'),
        DraftOrder: () => testing.withExamples(testing.valid(given.DraftOrder ?? testing.cast<Sales.DraftOrder>(fc.record({ state: fc.constant('Draft' as const), id: a.OrderId, items: testing.many(a.OrderItem, 0), customer: a.CustomerId, note: testing.cast<string>(scalar.String) }, { requiredKeys: ['state', 'id', 'items', 'customer'] })), (v) => Sales.checkDraftOrder(v).length === 0, 'Sales.DraftOrder'), options.examples?.Order?.states?.Draft, Sales.checkDraftOrder, 'Sales.DraftOrder'),
        ConfirmedOrder: () => testing.withExamples(testing.valid(given.ConfirmedOrder ?? testing.cast<Sales.ConfirmedOrder>(fc.record({ state: fc.constant('Confirmed' as const), id: a.OrderId, items: testing.many(a.OrderItem, 0), customer: a.CustomerId, note: testing.cast<string>(scalar.String), confirmedAt: testing.cast<Date>(scalar.Timestamp) }, { requiredKeys: ['state', 'id', 'items', 'customer', 'confirmedAt'] })), (v) => Sales.checkConfirmedOrder(v).length === 0, 'Sales.ConfirmedOrder'), options.examples?.Order?.states?.Confirmed, Sales.checkConfirmedOrder, 'Sales.ConfirmedOrder'),
        CancelledOrder: () => testing.withExamples(testing.valid(given.CancelledOrder ?? testing.cast<Sales.CancelledOrder>(fc.record({ state: fc.constant('Cancelled' as const), id: a.OrderId, items: testing.many(a.OrderItem, 0), customer: a.CustomerId, note: testing.cast<string>(scalar.String), reason: a.CancelReason }, { requiredKeys: ['state', 'id', 'items', 'customer', 'reason'] })), (v) => Sales.checkCancelledOrder(v).length === 0, 'Sales.CancelledOrder'), options.examples?.Order?.states?.Cancelled, Sales.checkCancelledOrder, 'Sales.CancelledOrder'),
        Order: () => given.Order ?? fc.oneof(a.DraftOrder, a.ConfirmedOrder, a.CancelledOrder),
        OrderItem: () => given.OrderItem ?? testing.cast<Sales.OrderItem>(fc.record({ id: a.OrderItemId, sku: a.Sku, quantity: a.Quantity, unitPrice: CommonArbs().Money })),
        OrderPlaced: () => given.OrderPlaced ?? testing.cast<Sales.OrderPlaced>(fc.record({ type: fc.constant('OrderPlaced' as const), orderId: a.OrderId })),
        OrderConfirmed: () => given.OrderConfirmed ?? testing.cast<Sales.OrderConfirmed>(fc.record({ type: fc.constant('OrderConfirmed' as const), orderId: a.OrderId, confirmedAt: testing.cast<Date>(scalar.Timestamp) })),
        OrderCancelled: () => given.OrderCancelled ?? testing.cast<Sales.OrderCancelled>(fc.record({ type: fc.constant('OrderCancelled' as const), orderId: a.OrderId, reason: a.CancelReason })),
        RefundRequested: () => given.RefundRequested ?? testing.cast<Sales.RefundRequested>(fc.record({ type: fc.constant('RefundRequested' as const), orderId: a.OrderId })),
        NoteChanged: () => given.NoteChanged ?? testing.cast<Sales.NoteChanged>(fc.record({ type: fc.constant('NoteChanged' as const), orderId: a.OrderId, note: testing.cast<string>(scalar.String) }, { requiredKeys: ['type', 'orderId'] })),
    });
    return a;
}

/**
 * The contract tests of Sales (ADR 0020), as a suite of named cases for any runner: for every \`make<Name>\` passed,
 * that it accepts exactly the values that hold the invariants; for every aggregate's commands passed, the error of the
 * first requirement that does not hold, the invariants of the aggregate made, event counts the types do not express,
 * and purity.
 * Inputs are generated from the types (deterministic: a fixed seed unless one is passed).
 */
export function contract(impl: Implementation, options: Options = {}): testing.Suite {
    const a = arbitraries(options);
    const scalar = testing.scalars(options.seed ?? testing.DEFAULT_SEED);
    return testing.suite('Sales', [
        impl.make && testing.suite('domain primitives', [
            ...(impl.make.CustomerId ? testing.primitiveCases({
                type: 'Sales.CustomerId',
                base: 'UUID',
                hints: {},
                invariants: ['uuid'],
                declared: [],
                check: () => Sales.checkCustomerId,
                make: impl.make.CustomerId,
            }, options) : []),
            ...(impl.make.OrderId ? testing.primitiveCases({
                type: 'Sales.OrderId',
                base: 'UUID',
                hints: {},
                invariants: ['uuid'],
                declared: [],
                check: () => Sales.checkOrderId,
                make: impl.make.OrderId,
            }, options) : []),
            ...(impl.make.OrderItemId ? testing.primitiveCases({
                type: 'Sales.OrderItemId',
                base: 'UUID',
                hints: {},
                invariants: ['uuid'],
                declared: [],
                check: () => Sales.checkOrderItemId,
                make: impl.make.OrderItemId,
            }, options) : []),
            ...(impl.make.Quantity ? testing.primitiveCases({
                type: 'Sales.Quantity',
                base: 'Int',
                hints: { ge: 1, le: 999 },
                invariants: ['valid'],
                declared: [],
                check: () => Sales.checkQuantity,
                make: impl.make.Quantity,
            }, options) : []),
            ...(impl.make.Sku ? testing.primitiveCases({
                type: 'Sales.Sku',
                base: 'String',
                hints: { pattern: '^[A-Z]{3}-\\\\d{4}$' },
                invariants: ['valid'],
                declared: [],
                check: () => Sales.checkSku,
                make: impl.make.Sku,
            }, options) : []),
        ]),
        impl.Customer && testing.suite('Customer', [
            ...testing.commandCases({
                name: 'Customer.register',
                run: impl.Customer.register,
                input: () => fc.tuple(fc.record({ id: a.CustomerId, name: testing.cast<string>(scalar.String), email: a.AvailableEmail })),
                examples: options.examples?.Customer?.commands?.register ?? [],
                factory: true,
                requires: [],
                declaredRequires: [],
                declaredInvariants: [],
                stateful: false,
                counted: [],
            }, options),
            ...testing.commandCases({
                name: 'Customer.rename',
                run: impl.Customer.rename,
                input: () => fc.tuple(a.Customer, fc.record({ name: testing.cast<string>(scalar.String) })),
                examples: options.examples?.Customer?.commands?.rename ?? [],
                factory: false,
                requires: [],
                declaredRequires: [],
                declaredInvariants: [],
                stateful: false,
                counted: [],
            }, options),
            ...testing.commandCases({
                name: 'Customer.changeEmail',
                run: impl.Customer.changeEmail,
                input: () => fc.tuple(a.Customer, fc.record({ email: a.AvailableEmail })),
                examples: options.examples?.Customer?.commands?.changeEmail ?? [],
                factory: false,
                requires: [],
                declaredRequires: [],
                declaredInvariants: [],
                stateful: false,
                counted: [],
            }, options),
        ]),
        impl.Order && testing.suite('Order', [
            ...testing.commandCases({
                name: 'Order.place',
                run: impl.Order.place,
                input: () => fc.tuple(fc.record({ id: a.OrderId, customer: a.CustomerId })),
                examples: options.examples?.Order?.commands?.place ?? [],
                factory: true,
                requires: [],
                declaredRequires: [],
                invariants: () => Sales.checkOrder,
                declaredInvariants: [],
                stateful: true,
                counted: [],
            }, options),
            ...testing.commandCases({
                name: 'Order.addItem',
                run: impl.Order.addItem,
                input: () => fc.tuple(fc.oneof(a.DraftOrder), fc.record({ item: a.OrderItem })),
                examples: options.examples?.Order?.commands?.addItem ?? [],
                factory: false,
                requires: [{ name: 'newSku', error: 'DuplicateSku' }, { name: 'sameCurrency', error: 'CurrencyMismatch' }],
                declaredRequires: [],
                firstFailing: () => Sales.checkAddItemOrderRequires,
                invariants: () => Sales.checkOrder,
                declaredInvariants: [],
                stateful: true,
                counted: [],
            }, options),
            ...testing.commandCases({
                name: 'Order.confirm',
                run: impl.Order.confirm,
                input: () => fc.tuple(fc.oneof(a.DraftOrder), fc.record({ at: testing.cast<Date>(scalar.Timestamp) })),
                examples: options.examples?.Order?.commands?.confirm ?? [],
                factory: false,
                requires: [{ name: 'hasItems', error: 'EmptyOrder' }],
                declaredRequires: [],
                firstFailing: () => Sales.checkConfirmOrderRequires,
                invariants: () => Sales.checkOrder,
                declaredInvariants: [],
                stateful: true,
                counted: [],
            }, options),
            ...testing.commandCases({
                name: 'Order.cancel',
                run: impl.Order.cancel,
                input: () => fc.tuple(fc.oneof(a.DraftOrder, a.ConfirmedOrder), fc.record({ reason: a.CancelReason })),
                examples: options.examples?.Order?.commands?.cancel ?? [],
                factory: false,
                requires: [{ name: 'noteForOther', error: 'NoteRequired' }],
                declaredRequires: [],
                firstFailing: () => Sales.checkCancelOrderRequires,
                invariants: () => Sales.checkOrder,
                declaredInvariants: [],
                stateful: true,
                counted: [],
            }, options),
            ...testing.commandCases({
                name: 'Order.changeNote',
                run: impl.Order.changeNote,
                input: () => fc.tuple(fc.oneof(a.DraftOrder, a.ConfirmedOrder), fc.record({ note: testing.cast<string>(scalar.String) }, { requiredKeys: [] })),
                examples: options.examples?.Order?.commands?.changeNote ?? [],
                factory: false,
                requires: [],
                declaredRequires: [],
                invariants: () => Sales.checkOrder,
                declaredInvariants: [],
                stateful: true,
                counted: [],
            }, options),
        ]),
    ]);
}
"
`;

exports[`dt generate ts of examples/shop the contents of each file: generated/domain/tests/_register.ts 1`] = `
"// Generated by domaintrail. DO NOT EDIT — change the .dt sources and run \`dt generate ts\`.

import { describe, test } from 'bun:test';
import { isSuite, type Suite } from 'domaintrail/testing';

/** Registers the cases of a generated suite with bun: a \`describe\` per suite, a test per case. */
export function register(suite: Suite): void {
    describe(suite.name, () => {
        for (const c of suite.children) {
            if (isSuite(c)) register(c);
            else if (c.todo) test.todo(c.name);
            else test(c.name, () => c.run());
        }
    });
}
"
`;

exports[`dt generate ts of examples/shop the contents of each file: generated/domain/tests/index.ts 1`] = `
"// Generated by domaintrail. DO NOT EDIT — change the .dt sources and run \`dt generate ts\`.

export { register } from './_register.js';
export * as Billing from './Billing.js';
export * as Common from './Common.js';
export * as Sales from './Sales.js';
"
`;
