    const [invariant] = checkSku(value);
    if (invariant === undefined) return ok(value as Sku);
    return err({ type: 'InvalidSku', value, invariant });
};

/**
 * Fields shared by every state of 注文 (Order).
 * @invariant quantitiesPositive (数量は正の値): all(items, item => item.quantity > 0)
 * @invariant distinctSkus (商品コードは明細ごとに一意): unique(items, item => item.sku)
 * @invariant singleCurrency (単価の通貨が揃っている): all(items, a => all(items, b => a.unitPrice.currency == b.unitPrice.currency))
 * @see sales/order.dt:13
 */
export interface OrderCommon {
    /** 注文ID */
    readonly id: OrderId;
    /** 明細 */
    readonly items: readonly OrderItem[];
    /**
     * 顧客
     * @see {@link Customer}
     */
    readonly customer: CustomerId;
    /** 備考 */
    readonly note?: string;
}

/**
 * 下書き
 * @see sales/order.dt:30
 */
export interface DraftOrder extends OrderCommon {
    readonly state: 'Draft';
}

/**
 * 確定済み
 * @invariant hasItems (明細が1件以上): count(items) > 0
 * @see sales/order.dt:32
 */
export interface ConfirmedOrder extends OrderCommon {
    readonly state: 'Confirmed';
    /** 確定日時 — 顧客が注文を確定した日時。キャンセル可否の判定に使う。 */
    readonly confirmedAt: Timestamp;
}

/**
 * 取消済み
 * @invariant otherNeedsNote (その他の取消には備考が必要): reason == CancelReason.Other implies exists(note)
 * @see sales/order.dt:37
 */
export interface CancelledOrder extends OrderCommon {
    readonly state: 'Cancelled';
    /** 取消理由 */
    readonly reason: CancelReason;
}

/**
 * 注文
 * 顧客からの購入依頼。確定後は明細を変更できない。
 * @see sales/order.dt:13
 */
export type Order = DraftOrder | ConfirmedOrder | CancelledOrder;

/**
 * The fields of Order as data for \`decide\`: the common fields, and the fields of each state on top of them.
 * @see sales/order.dt:13
 */
export const OrderShape: Shape = {
    fields: ['id', 'items', 'customer', 'note'],
    states: { Draft: [], Confirmed: ['confirmedAt'], Cancelled: ['reason'] },
};

/**
 * The invariants of Order (those of every state) that an aggregate violates, in declaration order; empty when it holds them all.
 * @see sales/order.dt:13
 */
export function checkOrderCommon(order: OrderCommon): readonly ('quantitiesPositive' | 'distinctSkus' | 'singleCurrency')[] {
    const violated: ('quantitiesPositive' | 'distinctSkus' | 'singleCurrency')[] = [];
    if (!(order.items.every((item) => item.quantity > 0))) violated.push('quantitiesPositive');
    if (!(distinct(order.items, (item, item2) => item.sku === item2.sku))) violated.push('distinctSkus');
    if (!(order.items.every((a) => order.items.every((b) => a.unitPrice.currency === b.unitPrice.currency)))) violated.push('singleCurrency');
    return violated;
