 * @see billing/invoice.dt:2
 */
export type MakeInvoiceId = (value: string) => Result<InvoiceId, InvalidInvoiceId>;

/**
 * The invariants of InvoiceId that a value violates, in declaration order after 'uuid'; empty when it is a InvoiceId.
 * @see billing/invoice.dt:2
 */
export function checkInvoiceId(value: string): readonly InvalidInvoiceId['invariant'][] {
    const violated: InvalidInvoiceId['invariant'][] = [];
    if (!(new RegExp('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$', 'u').test(value))) violated.push('uuid');
    return violated;
}

/**
 * Creates a InvoiceId, checking its invariants with \`checkInvoiceId\`: the first one violated is reported.
 * @see billing/invoice.dt:2
 */
export const makeInvoiceId: MakeInvoiceId = (value) => {
    const [invariant] = checkInvoiceId(value);
    if (invariant === undefined) return ok(value as InvoiceId);
    return err({ type: 'Billing.InvalidInvoiceId', value, invariant });
};

/**
 * Fields shared by every state of 請求書 (Invoice).
 * @see billing/invoice.dt:4
 */
export interface InvoiceCommon {
    /** 請求書ID */
    readonly id: InvoiceId;
