"// Generated by domaintrail. DO NOT EDIT — change the .dt sources and run \`dt generate ts\`.

import type { NoEvents, Result, Shape, Timestamp } from './_runtime.js';
import type * as Common from './Common.js';
import type * as Sales from './Sales.js';

/**
 * What the application needs to run Invoice.issue (a factory): its parameters, by name.
 * Given by the handlers of the policies that run it.
 * @see billing/invoice.dt:14
 */
export interface IssueInvoiceInput {
    /** 請求書ID */
    readonly id: InvoiceId;
    /** 注文ID */
    readonly order: Sales.OrderId;
    /** 請求金額 */
    readonly billedAmount: Common.Money;
}

/**
 * Policy BillConfirmedOrder: when Sales.OrderConfirmed happens, Invoice.issue is run — eventually.
 * 確定した注文に請求する
 * 確定した注文は、その合計で請求する。
 * The handler computes what the command needs from the event; your application runs the command. Any mechanism satisfies the rule: the same use case, an event bus, a batch. Data from elsewhere comes in through the closures your code builds; a rejected promise means the input cannot be computed now.
 * Required (\`generate.ts.policies\`): implement it in \`BillingPolicyHandlers\`, which the contract tests take.
 * @see billing/context.dt:9
 */
export type BillConfirmedOrderPolicy = (event: Sales.OrderConfirmed) => Promise<IssueInvoiceInput>;

/**
 * 請求書ID
 * Make it with \`makeInvoiceId\`; never \`as InvoiceId\` (see dt guide lint).
 * @see billing/invoice.dt:2
 */
export type InvoiceId = string & { readonly __domain: 'Billing.InvoiceId' };

/**
 * Creates a InvoiceId. It has no invariants, so creation cannot fail.
 * @see billing/invoice.dt:2
 */
export type MakeInvoiceId = (value: string) => InvoiceId;

/**
 * Creates a InvoiceId: it has no invariants, so every value is one.
 * @see billing/invoice.dt:2
 */
export const makeInvoiceId: MakeInvoiceId = (value) => value as InvoiceId;

/**
 * Fields shared by every state of 請求書 (Invoice).
 * @see billing/invoice.dt:4
 */
export interface InvoiceCommon {
    /** 請求書ID */
    readonly id: InvoiceId;
    /**
     * 注文
     * @see {@link Sales.Order}
     */
    readonly order: Sales.OrderId;
    /** 請求金額 */
    readonly billedAmount: Common.Money;
}

/**
 * 未払い
 * @see billing/invoice.dt:9
 */
export interface OpenInvoice extends InvoiceCommon {
    readonly state: 'Open';
}

/**
 * 支払済み
 * @see billing/invoice.dt:10
 */
export interface PaidInvoice extends InvoiceCommon {
    readonly state: 'Paid';
    /** 支払日時 */
    readonly paidAt: Timestamp;
}

/**
 * 請求書
 * @see billing/invoice.dt:4
 */
export type Invoice = OpenInvoice | PaidInvoice;

/**
 * The fields of Invoice as data for \`decide\`: the common fields, and the fields of each state on top of them.
 * @see billing/invoice.dt:4
 */
export const InvoiceShape: Shape = {
    fields: ['id', 'order', 'billedAmount'],
    states: { Open: [], Paid: ['paidAt'] },
};

/**
 * The invariants of Invoice (those of every state) that an aggregate violates, in declaration order; empty when it holds them all.
 * @see billing/invoice.dt:4
 */
export function checkInvoiceCommon(_invoice: InvoiceCommon): readonly never[] {
    return [];
}

/**
 * Invoice.issue (new -> Open) — factory
 * 請求書を発行する
 * @param id 請求書ID
 * @param order 注文ID
 * @param billedAmount 請求金額
 * @emits nothing
 * @see billing/invoice.dt:14
 */
export type IssueInvoice = (
    id: InvoiceId,
    order: Sales.OrderId,
    billedAmount: Common.Money,
) => Result<{
    readonly Open: {
        readonly aggregate: OpenInvoice;
        readonly events: NoEvents;
    };
}, never>;

/**
 * Invoice.issue, decided by one function; implement it with \`decide(InvoiceShape, …)\` from the runtime.
 * Each outcome gives the fields of \`set\`, and \`decide\` makes the aggregate from them.
 * new -> Open — set: every field
 * @emits nothing
 * @see billing/invoice.dt:14
 */
export type IssueInvoiceDecision = (
    id: InvoiceId,
    order: Sales.OrderId,
    billedAmount: Common.Money,
) => Result<{
    readonly Open: {
        readonly set: { readonly id: InvoiceId; readonly order: Sales.OrderId; readonly billedAmount: Common.Money };
        readonly events: NoEvents;
    };
}, never>;

/**
 * Invoice.pay (Open -> Paid)
 * 支払う
 * @param paidAt 支払日時
 * @changes none — the command changes no common field
 * @emits InvoicePaid — exactly once when the command succeeds
 * @see billing/invoice.dt:16
 */
export type PayInvoice = (
    invoice: OpenInvoice,
    paidAt: Timestamp,
) => Result<{
    readonly Paid: {
        readonly aggregate: PaidInvoice;
        readonly events: { readonly InvoicePaid: InvoicePaid };
    };
}, never>;

/**
 * Invoice.pay, decided per source state; implement it with \`decide(InvoiceShape, …)\` from the runtime.
 * Each outcome gives the fields of \`set\`, and \`decide\` makes the aggregate, taking the other fields from the input.
 * @changes none — the command changes no common field
 * Open -> Paid — set: paidAt (new in Paid); carried over: id, order, billedAmount
 * @see billing/invoice.dt:16
 */
export type PayInvoiceDecision = {
    /** @emits InvoicePaid — exactly once when the command succeeds */
    readonly Open: (invoice: OpenInvoice, paidAt: Timestamp) => Result<{
        readonly Paid: {
            readonly set: { readonly paidAt: Timestamp };
            readonly events: { readonly InvoicePaid: InvoicePaid };
        };
    }, never>;
};

/**
 * Command contracts of Invoice. Implement this interface by hand.
 * Commands are pure functions of the aggregate and their parameters: no I/O, no clock, no randomness. IDs and times are passed in as parameters.
 * @see billing/invoice.dt:4
 */
export interface InvoiceCommands {
    /** 請求書を発行する */
    readonly issue: IssueInvoice;
    /** 支払う */
    readonly pay: PayInvoice;
}

/**
 * Events that the commands of Invoice may emit.
 * @see billing/invoice.dt:4
 */
export type InvoiceEvent = InvoicePaid;

/**
 * 支払完了
 * 入金の記録として残す。
 * @persistent Persisted: storing this event is part of its contract.
 * @see billing/invoice.dt:22
 */
export interface InvoicePaid {
    readonly type: 'InvoicePaid';
    /** 請求書ID */
    readonly invoiceId: InvoiceId;
    /** 支払日時 */
    readonly paidAt: Timestamp;
}

/** Events of Billing that are persisted (declared \`persistent\`). */
export type PersistentEvent = InvoicePaid;

/** Events of Billing. */
export type DomainEvent = InvoicePaid;

/** Aggregates of Billing. */
export type Aggregate = Invoice;

/** The handlers of the policies of Billing, one per policy: required (\`generate.ts.policies\`), and taken by the contract tests. */
export interface BillingPolicyHandlers {
    /** 確定した注文に請求する */
    readonly BillConfirmedOrder: BillConfirmedOrderPolicy;
}
"
`;

