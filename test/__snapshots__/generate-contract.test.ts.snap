"// Generated by domaintrail. DO NOT EDIT — change the .dt sources and run \`dt generate ts\`.

import type { Decimal, Result } from './_runtime.js';
import { err, ok } from './_runtime.js';

/**
 * 通貨
 * @see common/context.dt:8
 */
export type Currency =
    | 'JPY' // 日本円
    | 'USD'; // 米ドル

/**
 * 額
 * 通貨を含まない金額の数値部分。返金なども正の額で表し、符号に意味を持たせない。
 * @invariant nonNegative (0以上): value >= 0
 * Make it with \`makeAmount\`; never \`as Amount\` (see dt guide lint).
 * @see common/context.dt:11
 */
export type Amount = Decimal & { readonly __domain: 'Common.Amount' };

/**
 * A value that violates an invariant of Amount.
 * @see common/context.dt:11
 */
export interface InvalidAmount {
    readonly type: 'InvalidAmount';
    readonly value: Decimal;
    /** The violated invariant. */
    readonly invariant: 'nonNegative';
}

/**
 * Creates a Amount, checking its invariants: generated as \`makeAmount\`, or written by hand.
 * @see common/context.dt:11
 */
export type MakeAmount = (value: Decimal) => Result<Amount, InvalidAmount>;

/**
 * The invariants of Amount that a value violates, in declaration order; empty when it is a Amount.
 * @see common/context.dt:11
 */
export function checkAmount(value: Decimal): readonly InvalidAmount['invariant'][] {
    const violated: InvalidAmount['invariant'][] = [];
    if (!(Number(value) >= 0)) violated.push('nonNegative');
    return violated;
}

/**
 * Creates a Amount, checking its invariants with \`checkAmount\`: the first one violated is reported.
 * @see common/context.dt:11
 */
export const makeAmount: MakeAmount = (value) => {
    const [invariant] = checkAmount(value);
    if (invariant === undefined) return ok(value as Amount);
    return err({ type: 'InvalidAmount', value, invariant });
};

/**
 * 金額
 * @see common/context.dt:15
 */
export interface Money {
    /** 額 */
    readonly amount: Amount;
    /** 通貨 */
    readonly currency: Currency;
}

/**
 * Whether two Money values are equal: by all their fields (ADR 0016).
 * @see common/context.dt:15
 */
export function equalMoney(a: Money, b: Money): boolean {
    return Number(a.amount) === Number(b.amount) && a.currency === b.currency;
}

/**
 * メールアドレス
 * @invariant format (形式): matches(value, "^[^@\\s]+@[^@\\s]+$")
 * @invariant maxLength (254文字以内): length(value) <= 254
 * Make it with \`makeEmailAddress\`; never \`as EmailAddress\` (see dt guide lint).
 * @see common/context.dt:20
 */
export type EmailAddress = string & { readonly __domain: 'Common.EmailAddress' };

/**
 * A value that violates an invariant of EmailAddress.
 * @see common/context.dt:20
 */
export interface InvalidEmailAddress {
    readonly type: 'InvalidEmailAddress';
    readonly value: string;
    /** The violated invariant. */
    readonly invariant: 'format' | 'maxLength';
}

/**
 * Creates a EmailAddress, checking its invariants: generated as \`makeEmailAddress\`, or written by hand.
 * @see common/context.dt:20
 */
export type MakeEmailAddress = (value: string) => Result<EmailAddress, InvalidEmailAddress>;

/**
 * The invariants of EmailAddress that a value violates, in declaration order; empty when it is a EmailAddress.
 * @see common/context.dt:20
 */
export function checkEmailAddress(value: string): readonly InvalidEmailAddress['invariant'][] {
    const violated: InvalidEmailAddress['invariant'][] = [];
    if (!(/^[^@\\s]+@[^@\\s]+$/.test(value))) violated.push('format');
    if (!(value.length <= 254)) violated.push('maxLength');
    return violated;
}

/**
 * Creates a EmailAddress, checking its invariants with \`checkEmailAddress\`: the first one violated is reported.
 * @see common/context.dt:20
 */
export const makeEmailAddress: MakeEmailAddress = (value) => {
    const [invariant] = checkEmailAddress(value);
    if (invariant === undefined) return ok(value as EmailAddress);
    return err({ type: 'InvalidEmailAddress', value, invariant });
};
"
`;

