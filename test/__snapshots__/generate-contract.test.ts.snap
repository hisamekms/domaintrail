    readonly type: 'InvalidSku';
    readonly value: string;
    /** The violated invariant. */
    readonly invariant: 'valid';
}

/**
 * Creates a Sku, checking its invariants: generated as \`makeSku\`, or written by hand.
 * @see sales/order.dt:10
 */
export type MakeSku = (value: string) => Result<Sku, InvalidSku>;

/**
 * The invariants of Sku that a value violates, in declaration order; empty when it is a Sku.
 * @see sales/order.dt:10
 */
export function checkSku(value: string): readonly InvalidSku['invariant'][] {
    const violated: InvalidSku['invariant'][] = [];
