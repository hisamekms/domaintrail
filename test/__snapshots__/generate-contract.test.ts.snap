/**
 * 注文ID
 * @invariant uuid: the form of a UUID (RFC 9562): 8-4-4-4-12 hexadecimal digits, in either case, of any version
 * Make it with \`makeOrderId\`; never \`as OrderId\` (see dt guide lint).
 * @see sales/order.dt:2
 */
export type OrderId = string & { readonly __domain: 'Sales.OrderId' };

/**
 * A value that violates an invariant of OrderId.
 * @see sales/order.dt:2
 */
export interface InvalidOrderId {
    readonly type: 'Sales.InvalidOrderId';
    readonly value: string;
    /** The violated invariant. */
    readonly invariant: 'uuid';
}

/**
 * Creates a OrderId, checking its invariants: generated as \`makeOrderId\`, or written by hand.
 * @see sales/order.dt:2
 */
export type MakeOrderId = (value: string) => Result<OrderId, InvalidOrderId>;

/**
 * The invariants of OrderId that a value violates, in declaration order after 'uuid'; empty when it is a OrderId.
 * @see sales/order.dt:2
 */
export function checkOrderId(value: string): readonly InvalidOrderId['invariant'][] {
    const violated: InvalidOrderId['invariant'][] = [];
    if (!(new RegExp('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$', 'u').test(value))) violated.push('uuid');
    return violated;
}

/**
 * Creates a OrderId, checking its invariants with \`checkOrderId\`: the first one violated is reported.
 * @see sales/order.dt:2
 */
export const makeOrderId: MakeOrderId = (value) => {
    const [invariant] = checkOrderId(value);
    if (invariant === undefined) return ok(value as OrderId);
    return err({ type: 'Sales.InvalidOrderId', value, invariant });
};

/**
 * 注文明細ID
 * @invariant uuid: the form of a UUID (RFC 9562): 8-4-4-4-12 hexadecimal digits, in either case, of any version
 * Make it with \`makeOrderItemId\`; never \`as OrderItemId\` (see dt guide lint).
 * @see sales/order.dt:3
 */
export type OrderItemId = string & { readonly __domain: 'Sales.OrderItemId' };

/**
 * A value that violates an invariant of OrderItemId.
 * @see sales/order.dt:3
 */
export interface InvalidOrderItemId {
    readonly type: 'Sales.InvalidOrderItemId';
    readonly value: string;
    /** The violated invariant. */
    readonly invariant: 'uuid';
}

/**
 * Creates a OrderItemId, checking its invariants: generated as \`makeOrderItemId\`, or written by hand.
 * @see sales/order.dt:3
 */
export type MakeOrderItemId = (value: string) => Result<OrderItemId, InvalidOrderItemId>;

/**
 * The invariants of OrderItemId that a value violates, in declaration order after 'uuid'; empty when it is a OrderItemId.
 * @see sales/order.dt:3
 */
export function checkOrderItemId(value: string): readonly InvalidOrderItemId['invariant'][] {
    const violated: InvalidOrderItemId['invariant'][] = [];
    if (!(new RegExp('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$', 'u').test(value))) violated.push('uuid');
    return violated;
}

/**
 * Creates a OrderItemId, checking its invariants with \`checkOrderItemId\`: the first one violated is reported.
 * @see sales/order.dt:3
 */
export const makeOrderItemId: MakeOrderItemId = (value) => {
    const [invariant] = checkOrderItemId(value);
    if (invariant === undefined) return ok(value as OrderItemId);
    return err({ type: 'Sales.InvalidOrderItemId', value, invariant });
};

/**
 * 取消理由
 * @see sales/order.dt:5
 */
export type CancelReason =
    | 'Requested' // 顧客都合
    | 'Other'; // その他

/**
 * 数量
 * @invariant valid: value in 1..999
 * Make it with \`makeQuantity\`; never \`as Quantity\` (see dt guide lint).
 * @see sales/order.dt:7
 */
export type Quantity = number & { readonly __domain: 'Sales.Quantity' };

/**
 * A value that violates an invariant of Quantity.
 * @see sales/order.dt:7
 */
export interface InvalidQuantity {
    readonly type: 'Sales.InvalidQuantity';
    readonly value: number;
    /** The violated invariant. */
    readonly invariant: 'valid';
}

/**
 * Creates a Quantity, checking its invariants: generated as \`makeQuantity\`, or written by hand.
 * @see sales/order.dt:7
 */
export type MakeQuantity = (value: number) => Result<Quantity, InvalidQuantity>;

/**
 * The invariants of Quantity that a value violates, in declaration order; empty when it is a Quantity.
 * @see sales/order.dt:7
 */
export function checkQuantity(value: number): readonly InvalidQuantity['invariant'][] {
    const violated: InvalidQuantity['invariant'][] = [];
    if (!(1 <= value && value <= 999)) violated.push('valid');
    return violated;
}

/**
 * Creates a Quantity, checking its invariants with \`checkQuantity\`: the first one violated is reported.
 * @see sales/order.dt:7
 */
export const makeQuantity: MakeQuantity = (value) => {
    const [invariant] = checkQuantity(value);
    if (invariant === undefined) return ok(value as Quantity);
    return err({ type: 'Sales.InvalidQuantity', value, invariant });
};

/**
 * 商品コード
 * 英大文字3桁-数字4桁の商品コード。
 * @invariant valid: matches(value, "^[A-Z]{3}-\\d{4}$")
 * Make it with \`makeSku\`; never \`as Sku\` (see dt guide lint).
 * @see sales/order.dt:10
 */
export type Sku = string & { readonly __domain: 'Sales.Sku' };

/**
 * A value that violates an invariant of Sku.
 * @see sales/order.dt:10
 */
export interface InvalidSku {
    readonly type: 'Sales.InvalidSku';
    readonly value: string;
    /** The violated invariant. */
    readonly invariant: 'valid';
}

/**
 * Creates a Sku, checking its invariants: generated as \`makeSku\`, or written by hand.
 * @see sales/order.dt:10
 */
export type MakeSku = (value: string) => Result<Sku, InvalidSku>;

/**
 * The invariants of Sku that a value violates, in declaration order; empty when it is a Sku.
 * @see sales/order.dt:10
 */
export function checkSku(value: string): readonly InvalidSku['invariant'][] {
    const violated: InvalidSku['invariant'][] = [];
    if (!(new RegExp('^[A-Z]{3}-[0-9]{4}$', 'u').test(value))) violated.push('valid');
    return violated;
}

/**
 * Creates a Sku, checking its invariants with \`checkSku\`: the first one violated is reported.
 * @see sales/order.dt:10
 */
export const makeSku: MakeSku = (value) => {
    const [invariant] = checkSku(value);
    if (invariant === undefined) return ok(value as Sku);
    return err({ type: 'Sales.InvalidSku', value, invariant });
};

/**
 * Fields shared by every state of 注文 (Order).
 * @invariant quantitiesPositive (数量は正の値): all(items, item => item.quantity > 0)
 * @invariant distinctSkus (商品コードは明細ごとに一意): unique(items, item => item.sku)
 * @invariant singleCurrency (単価の通貨が揃っている): all(items, a => all(items, b => a.unitPrice.currency == b.unitPrice.currency))
 * @see sales/order.dt:13
 */
export interface OrderCommon {
    /** 注文ID */
    readonly id: OrderId;
    /** 明細 */
    readonly items: readonly OrderItem[];
    /**
     * 顧客
     * @see {@link Customer}
     */
    readonly customer: CustomerId;
    /** 備考 */
    readonly note?: string;
}

/**
 * 下書き
 * @see sales/order.dt:30
 */
export interface DraftOrder extends OrderCommon {
    readonly state: 'Draft';
}

/**
 * 確定済み
 * @invariant hasItems (明細が1件以上): count(items) > 0
 * @see sales/order.dt:32
 */
export interface ConfirmedOrder extends OrderCommon {
    readonly state: 'Confirmed';
    /** 確定日時 — 顧客が注文を確定した日時。キャンセル可否の判定に使う。 */
    readonly confirmedAt: Timestamp;
}

/**
 * 取消済み
 * @invariant otherNeedsNote (その他の取消には備考が必要): reason == CancelReason.Other implies exists(note)
 * @see sales/order.dt:37
 */
export interface CancelledOrder extends OrderCommon {
    readonly state: 'Cancelled';
    /** 取消理由 */
    readonly reason: CancelReason;
}

/**
 * 注文
 * 顧客からの購入依頼。確定後は明細を変更できない。
 * @see sales/order.dt:13
 */
export type Order = DraftOrder | ConfirmedOrder | CancelledOrder;

/**
 * Restores a trusted Order value after caller-side decoding, validation and migration.
 * This function does not validate persisted data, invariants or kind–state pairs.
 * @see sales/order.dt:13
 */
export const restoreOrder = (trusted: Order): Order => trusted;

/**
 * The fields of Order as data for \`decide\`: the common fields, and the fields of each state on top of them.
 * @see sales/order.dt:13
 */
export const OrderShape: Shape = {
    fields: ['id', 'items', 'customer', 'note'],
    states: { Draft: [], Confirmed: ['confirmedAt'], Cancelled: ['reason'] },
};

/**
 * The invariants of Order (those of every state) that an aggregate violates, in declaration order; empty when it holds them all.
 * @see sales/order.dt:13
 */
export function checkOrderCommon(order: OrderCommon): readonly ('quantitiesPositive' | 'distinctSkus' | 'singleCurrency')[] {
    const violated: ('quantitiesPositive' | 'distinctSkus' | 'singleCurrency')[] = [];
    if (!(order.items.every((item) => item.quantity > 0))) violated.push('quantitiesPositive');
    if (!(distinct(order.items, (item, item2) => item.sku === item2.sku))) violated.push('distinctSkus');
    if (!(order.items.every((a) => order.items.every((b) => a.unitPrice.currency === b.unitPrice.currency)))) violated.push('singleCurrency');
    return violated;
}

/**
 * The invariants of Order in state Draft (the aggregate's, by \`checkOrderCommon\`, and the state's) that an aggregate violates, in declaration order.
 * @see sales/order.dt:30
 */
export function checkDraftOrder(order: DraftOrder): readonly ('quantitiesPositive' | 'distinctSkus' | 'singleCurrency')[] {
    return checkOrderCommon(order);
}

/**
 * The invariants of Order in state Confirmed (the aggregate's, by \`checkOrderCommon\`, and the state's) that an aggregate violates, in declaration order.
 * @see sales/order.dt:32
 */
export function checkConfirmedOrder(order: ConfirmedOrder): readonly ('quantitiesPositive' | 'distinctSkus' | 'singleCurrency' | 'hasItems')[] {
    const violated: ('quantitiesPositive' | 'distinctSkus' | 'singleCurrency' | 'hasItems')[] = [...checkOrderCommon(order)];
    if (!(order.items.length > 0)) violated.push('hasItems');
    return violated;
}

/**
 * The invariants of Order in state Cancelled (the aggregate's, by \`checkOrderCommon\`, and the state's) that an aggregate violates, in declaration order.
 * @see sales/order.dt:37
 */
export function checkCancelledOrder(order: CancelledOrder): readonly ('quantitiesPositive' | 'distinctSkus' | 'singleCurrency' | 'otherNeedsNote')[] {
    const violated: ('quantitiesPositive' | 'distinctSkus' | 'singleCurrency' | 'otherNeedsNote')[] = [...checkOrderCommon(order)];
    if (order.reason === 'Other' && !(order.note !== undefined)) violated.push('otherNeedsNote');
    return violated;
}

/**
 * The invariants of Order in the state it is in that an aggregate violates (see the check of each state).
 * @see sales/order.dt:13
 */
export function checkOrder(order: Order): readonly ('quantitiesPositive' | 'distinctSkus' | 'singleCurrency' | 'hasItems' | 'otherNeedsNote')[] {
    switch (order.state) {
        case 'Draft': return checkDraftOrder(order);
        case 'Confirmed': return checkConfirmedOrder(order);
        case 'Cancelled': return checkCancelledOrder(order);
    }
}

/**
 * The parameters of Order.place, by name.
 * @see sales/order.dt:26
 */
export interface PlaceOrderParams {
    /** 注文ID */
    readonly id: OrderId;
    /** 顧客ID */
    readonly customer: CustomerId;
}

/**
 * Order.place (new -> Draft) — factory
 * 注文する
 * @emits OrderPlaced — exactly once when the command succeeds
 * @see sales/order.dt:26
 */
export type PlaceOrder = (
    params: PlaceOrderParams,
) => Result<{
    readonly Draft: {
        readonly aggregate: DraftOrder;
        readonly events: { readonly 'Sales.OrderPlaced': OrderPlaced };
    };
}, never>;

/**
 * Order.place, decided by one function; implement it with \`decide(OrderShape, …)\` from the runtime.
 * Each outcome gives the fields of \`set\`, and \`decide\` makes the aggregate from them.
 * new -> Draft — set: every field
 * @emits OrderPlaced — exactly once when the command succeeds
 * @see sales/order.dt:26
 */
export type PlaceOrderDecision = (
    params: PlaceOrderParams,
) => Result<{
    readonly Draft: {
        readonly set: { readonly id: OrderId; readonly items: readonly OrderItem[]; readonly customer: CustomerId; readonly note: string | undefined };
        readonly events: { readonly 'Sales.OrderPlaced': OrderPlaced };
    };
}, never>;

/**
 * The parameters of Order.addItem, by name.
 * @see sales/order.dt:43
 */
export interface AddItemOrderParams {
    /** 追加する明細 */
    readonly item: OrderItem;
}

/**
 * Order.addItem (Draft -> Draft)
 * 明細を追加する
 * @requires newSku (同じ商品コードの明細がない) else DuplicateSku: all(items, i => i.sku != item.sku)
 * @requires sameCurrency (既存の明細と同じ通貨) else CurrencyMismatch: all(items, i => i.unitPrice.currency == item.unitPrice.currency)
 * @changes items
 * @emits nothing
 * @see sales/order.dt:43
 */
export type AddItemOrder = (
    order: DraftOrder,
    params: AddItemOrderParams,
) => Result<{
    readonly Draft: {
        readonly aggregate: DraftOrder;
        readonly events: NoEvents;
    };
}, DuplicateSku | CurrencyMismatch>;

/**
 * Order.addItem, decided per source state; implement it with \`decide(OrderShape, …)\` from the runtime.
 * Each outcome gives the fields of \`set\`, and \`decide\` makes the aggregate, taking the other fields from the input.
 * @requires newSku (同じ商品コードの明細がない) else DuplicateSku: all(items, i => i.sku != item.sku)
 * @requires sameCurrency (既存の明細と同じ通貨) else CurrencyMismatch: all(items, i => i.unitPrice.currency == item.unitPrice.currency)
 * @changes items
 * Draft -> Draft — set: items; carried over: id, customer, note
 * @see sales/order.dt:43
 */
export type AddItemOrderDecision = {
    /** @emits nothing */
    readonly Draft: (order: DraftOrder, params: AddItemOrderParams) => Result<{
        readonly Draft: {
            readonly set: { readonly items: readonly OrderItem[] };
            readonly events: NoEvents;
        };
    }, DuplicateSku | CurrencyMismatch>;
};

/**
 * The first requirement of Order.addItem that does not hold, in declaration order; \`undefined\` when all hold.
 * @see sales/order.dt:43
 */
export function checkAddItemOrderRequires(order: DraftOrder, params: AddItemOrderParams): 'newSku' | 'sameCurrency' | undefined {
    if (!(order.items.every((i) => !(i.sku === params.item.sku)))) return 'newSku';
    if (!(order.items.every((i) => i.unitPrice.currency === params.item.unitPrice.currency))) return 'sameCurrency';
    return undefined;
}

/**
 * The parameters of Order.confirm, by name.
 * @see sales/order.dt:51
 */
export interface ConfirmOrderParams {
    /** 日時 */
    readonly at: Timestamp;
}

/**
 * Order.confirm (Draft -> Confirmed)
 * 注文を確定する
 * @requires hasItems (明細が1件以上) else EmptyOrder: count(items) > 0
 * @changes none — the command changes no common field
 * @emits OrderConfirmed — exactly once when the command succeeds
 * @see sales/order.dt:51
 */
export type ConfirmOrder = (
    order: DraftOrder,
    params: ConfirmOrderParams,
) => Result<{
    readonly Confirmed: {
        readonly aggregate: ConfirmedOrder;
        readonly events: { readonly 'Sales.OrderConfirmed': OrderConfirmed };
    };
}, EmptyOrder>;

/**
 * Order.confirm, decided per source state; implement it with \`decide(OrderShape, …)\` from the runtime.
 * Each outcome gives the fields of \`set\`, and \`decide\` makes the aggregate, taking the other fields from the input.
 * @requires hasItems (明細が1件以上) else EmptyOrder: count(items) > 0
 * @changes none — the command changes no common field
 * Draft -> Confirmed — set: confirmedAt (new in Confirmed); carried over: id, items, customer, note
 * @see sales/order.dt:51
 */
export type ConfirmOrderDecision = {
    /** @emits OrderConfirmed — exactly once when the command succeeds */
    readonly Draft: (order: DraftOrder, params: ConfirmOrderParams) => Result<{
        readonly Confirmed: {
            readonly set: { readonly confirmedAt: Timestamp };
            readonly events: { readonly 'Sales.OrderConfirmed': OrderConfirmed };
        };
    }, EmptyOrder>;
};

/**
 * The first requirement of Order.confirm that does not hold, in declaration order; \`undefined\` when all hold.
 * @see sales/order.dt:51
 */
export function checkConfirmOrderRequires(order: DraftOrder, _params: ConfirmOrderParams): 'hasItems' | undefined {
    if (!(order.items.length > 0)) return 'hasItems';
    return undefined;
}

/**
 * The parameters of Order.cancel, by name.
 * @see sales/order.dt:56
 */
export interface CancelOrderParams {
    /** 取消理由 */
    readonly reason: CancelReason;
}

/**
 * Order.cancel (Draft | Confirmed -> Cancelled)
 * 注文を取り消す
 * @requires noteForOther (その他の取消には備考が必要) else NoteRequired: reason == CancelReason.Other implies exists(note)
 * @changes none — the command changes no common field
 * @emits OrderCancelled — exactly once when the command succeeds
 * @emits RefundRequested — exactly once when it comes from Confirmed
 * @see sales/order.dt:56
 */
export type CancelOrder = <S extends DraftOrder | ConfirmedOrder>(
    order: S,
    params: CancelOrderParams,
) => {
    /** @emits OrderCancelled — exactly once when the command succeeds */
    readonly Draft: Result<{
        readonly Cancelled: {
            readonly aggregate: CancelledOrder;
            readonly events: { readonly 'Sales.OrderCancelled': OrderCancelled };
        };
    }, NoteRequired>;
    /**
     * @emits OrderCancelled — exactly once when the command succeeds
     * @emits RefundRequested — exactly once when the command succeeds
     */
    readonly Confirmed: Result<{
        readonly Cancelled: {
            readonly aggregate: CancelledOrder;
            readonly events: { readonly 'Sales.OrderCancelled': OrderCancelled; readonly 'Sales.RefundRequested': RefundRequested };
        };
    }, NoteRequired>;
}[S['state']];

/**
 * Order.cancel, decided per source state; implement it with \`decide(OrderShape, …)\` from the runtime.
 * Each outcome gives the fields of \`set\`, and \`decide\` makes the aggregate, taking the other fields from the input.
 * @requires noteForOther (その他の取消には備考が必要) else NoteRequired: reason == CancelReason.Other implies exists(note)
 * @changes none — the command changes no common field
 * Draft -> Cancelled — set: reason (new in Cancelled); carried over: id, items, customer, note
 * Confirmed -> Cancelled — set: reason (new in Cancelled); carried over: id, items, customer, note; dropped: confirmedAt
 * @see sales/order.dt:56
 */
export type CancelOrderDecision = {
    /** @emits OrderCancelled — exactly once when the command succeeds */
    readonly Draft: (order: DraftOrder, params: CancelOrderParams) => Result<{
        readonly Cancelled: {
            readonly set: { readonly reason: CancelReason };
            readonly events: { readonly 'Sales.OrderCancelled': OrderCancelled };
        };
    }, NoteRequired>;
    /**
     * @emits OrderCancelled — exactly once when the command succeeds
     * @emits RefundRequested — exactly once when the command succeeds
     */
    readonly Confirmed: (order: ConfirmedOrder, params: CancelOrderParams) => Result<{
        readonly Cancelled: {
            readonly set: { readonly reason: CancelReason };
            readonly events: { readonly 'Sales.OrderCancelled': OrderCancelled; readonly 'Sales.RefundRequested': RefundRequested };
        };
    }, NoteRequired>;
};

/**
 * The first requirement of Order.cancel that does not hold, in declaration order; \`undefined\` when all hold.
 * @see sales/order.dt:56
 */
export function checkCancelOrderRequires(order: DraftOrder | ConfirmedOrder, params: CancelOrderParams): 'noteForOther' | undefined {
    if (params.reason === 'Other' && !(order.note !== undefined)) return 'noteForOther';
    return undefined;
}

/**
 * The parameters of Order.changeNote, by name.
 * @see sales/order.dt:66
 */
export interface ChangeNoteOrderParams {
    /** 備考 */
    readonly note?: string;
}

/**
 * Order.changeNote (Draft -> Draft; Confirmed -> Confirmed)
 * 備考を変更する
 * 確定後も備考は変更できる。状態は変わらない。
 * 備考が変わらなければイベントは発生しない。
 * @changes note
 * @emits NoteChanged? — at most once when the command succeeds
 * @see sales/order.dt:66
 */
export type ChangeNoteOrder = <S extends DraftOrder | ConfirmedOrder>(
    order: S,
    params: ChangeNoteOrderParams,
) => {
    /** @emits NoteChanged? — at most once when the command succeeds */
    readonly Draft: Result<{
        readonly Draft: {
            readonly aggregate: DraftOrder;
            readonly events: { readonly 'Sales.NoteChanged'?: NoteChanged };
        };
    }, never>;
    /** @emits NoteChanged? — at most once when the command succeeds */
    readonly Confirmed: Result<{
        readonly Confirmed: {
            readonly aggregate: ConfirmedOrder;
            readonly events: { readonly 'Sales.NoteChanged'?: NoteChanged };
        };
    }, never>;
}[S['state']];

/**
 * Order.changeNote, decided per source state; implement it with \`decide(OrderShape, …)\` from the runtime.
 * Each outcome gives the fields of \`set\`, and \`decide\` makes the aggregate, taking the other fields from the input.
 * @changes note
 * Draft -> Draft — set: note; carried over: id, items, customer
 * Confirmed -> Confirmed — set: note; carried over: id, items, customer, confirmedAt
 * @see sales/order.dt:66
 */
export type ChangeNoteOrderDecision = {
    /** @emits NoteChanged? — at most once when the command succeeds */
    readonly Draft: (order: DraftOrder, params: ChangeNoteOrderParams) => Result<{
        readonly Draft: {
            readonly set: { readonly note: string | undefined };
            readonly events: { readonly 'Sales.NoteChanged'?: NoteChanged };
        };
    }, never>;
    /** @emits NoteChanged? — at most once when the command succeeds */
    readonly Confirmed: (order: ConfirmedOrder, params: ChangeNoteOrderParams) => Result<{
        readonly Confirmed: {
            readonly set: { readonly note: string | undefined };
            readonly events: { readonly 'Sales.NoteChanged'?: NoteChanged };
        };
    }, never>;
};

/**
 * Command contracts of Order. Implement this interface by hand.
 * Commands are pure functions of the aggregate and their parameters: no I/O, no clock, no randomness. IDs and times are passed in as parameters.
 * @see sales/order.dt:13
 */
export interface OrderCommands {
    /** 注文する */
    readonly place: PlaceOrder;
    /** 明細を追加する */
    readonly addItem: AddItemOrder;
    /** 注文を確定する */
    readonly confirm: ConfirmOrder;
    /** 注文を取り消す */
    readonly cancel: CancelOrder;
    /** 備考を変更する */
    readonly changeNote: ChangeNoteOrder;
}

/**
 * Events that the commands of Order may emit.
 * @see sales/order.dt:13
 */
export type OrderEvent = OrderPlaced | OrderConfirmed | OrderCancelled | RefundRequested | NoteChanged;

/**
 * Where the commands of Order can be called: the source states of each command.
 * Data for \`isAvailable\`, \`availableCommands\` and \`fromAnyState\` of the runtime.
 * @see sales/order.dt:13
 */
export const OrderAvailability: Availability = {
    aggregate: 'Sales.Order',
    commands: {
        addItem: { '*': ['Draft'] },
        confirm: { '*': ['Draft'] },
        cancel: { '*': ['Draft', 'Confirmed'] },
        changeNote: { '*': ['Draft', 'Confirmed'] },
    },
};

/**
 * Whether Order.addItem can be called on the order in its state (Draft).
 * @see sales/order.dt:43
 */
export const canAddItemOrder = (order: Order): order is DraftOrder => isAvailable(OrderAvailability, 'addItem', order);

/**
 * The error of Order.addItem called through \`anyStateOrderCommands\` on the order when its state is not one of its source states.
 * @see sales/order.dt:43
 */
export type AddItemOrderUnavailable = CommandUnavailable<'Sales.Order', 'addItem', 'Confirmed' | 'Cancelled', 'Draft'>;

/**
 * Order.addItem for the order in any state: the command in a source state (Draft), and \`AddItemOrderUnavailable\` in another.
 * @see sales/order.dt:43
 */
export type AddItemOrderFromAnyState = (
    order: Order,
    params: AddItemOrderParams,
) => ReturnType<AddItemOrder> | Err<AddItemOrderUnavailable>;

/**
 * Whether Order.confirm can be called on the order in its state (Draft).
 * @see sales/order.dt:51
 */
export const canConfirmOrder = (order: Order): order is DraftOrder => isAvailable(OrderAvailability, 'confirm', order);

/**
 * The error of Order.confirm called through \`anyStateOrderCommands\` on the order when its state is not one of its source states.
 * @see sales/order.dt:51
 */
export type ConfirmOrderUnavailable = CommandUnavailable<'Sales.Order', 'confirm', 'Confirmed' | 'Cancelled', 'Draft'>;

/**
 * Order.confirm for the order in any state: the command in a source state (Draft), and \`ConfirmOrderUnavailable\` in another.
 * @see sales/order.dt:51
 */
export type ConfirmOrderFromAnyState = (
    order: Order,
    params: ConfirmOrderParams,
) => ReturnType<ConfirmOrder> | Err<ConfirmOrderUnavailable>;

/**
