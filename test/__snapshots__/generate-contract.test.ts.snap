 * @see billing/invoice.dt:4
 */
export const InvoiceAvailability: Availability = {
    aggregate: 'Billing.Invoice',
    commands: {
        pay: { '*': ['Open'] },
    },
};

/**
 * Whether Invoice.pay can be called on the invoice in its state (Open).
 * @see billing/invoice.dt:16
 */
export const canPayInvoice = (invoice: Invoice): invoice is OpenInvoice => isAvailable(InvoiceAvailability, 'pay', invoice);

/**
 * The error of Invoice.pay called through \`anyStateInvoiceCommands\` on the invoice when its state is not one of its source states.
 * @see billing/invoice.dt:16
 */
export type PayInvoiceUnavailable = CommandUnavailable<'Billing.Invoice', 'pay', 'Paid', 'Open'>;

/**
 * Invoice.pay for the invoice in any state: the command in a source state (Open), and \`PayInvoiceUnavailable\` in another.
 * @see billing/invoice.dt:16
 */
export type PayInvoiceFromAnyState = (
