 * @see billing/invoice.dt:4
 */
export const availableInvoiceCommands = (invoice: Invoice): (keyof InvoiceCommandsFromAnyState)[] => availableCommands(InvoiceAvailability, invoice) as (keyof InvoiceCommandsFromAnyState)[];

/**
