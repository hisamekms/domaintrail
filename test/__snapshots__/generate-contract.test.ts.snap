/**
 * Creates a OrderItemId: it has no invariants, so every value is one.
 * @see sales/order.dt:3
 */
export const makeOrderItemId: MakeOrderItemId = (value) => value as OrderItemId;

/**
 * 取消理由
 * @see sales/order.dt:5
 */
export type CancelReason =
    | 'Requested' // 顧客都合
    | 'Other'; // その他

/**
 * 数量
 * @invariant valid: value in 1..999
 * Make it with \`makeQuantity\`; never \`as Quantity\` (see dt guide lint).
 * @see sales/order.dt:7
 */
export type Quantity = number & { readonly __domain: 'Sales.Quantity' };

