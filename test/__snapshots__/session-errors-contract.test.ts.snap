exports[`refused requests of a session in dev mode status and body of each refusal 1`] = `
{
  "DELETE runs": [
    405,
    {
      "error": {
        "message": "Use GET or POST.",
        "type": "MethodNotAllowed",
      },
    },
  ],
  "GET an unknown API": [
    404,
    {
      "error": {
        "message": "No such session API.",
        "type": "NotFound",
      },
    },
  ],
  "GET state, signed out": [
    401,
    {
      "error": {
        "message": "Sign in to the session first.",
        "type": "Unauthenticated",
      },
    },
  ],
  "POST close, participant": [
    403,
    {
      "error": {
        "message": "Only the facilitator may do this.",
        "type": "FacilitatorOnly",
      },
    },
  ],
  "POST facilitator/link, participant": [
    403,
    {
      "error": {
        "message": "Only the facilitator may do this.",
        "type": "FacilitatorOnly",
      },
    },
  ],
  "POST marks Vote on a message, participant": [
    400,
    {
      "error": {
        "type": "MarkNotForTarget",
      },
    },
  ],
  "POST marks Vote, facilitator": [
    403,
    {
      "error": {
        "message": "The facilitator's answer is the decision: the facilitator does not vote.",
        "type": "FacilitatorDoesNotVote",
      },
    },
  ],
  "POST marks on an unknown message": [
    404,
    {
      "error": {
        "type": "MarkTargetNotFound",
      },
    },
  ],
  "POST requests apply (gone), participant": [
    400,
    {
      "error": {
        "field": "apply",
        "message": "Unknown field.",
        "type": "InvalidInput",
      },
    },
  ],
  "POST requests mentioning a stranger": [
    400,
    {
      "error": {
        "participant": "<uuid>",
        "type": "MentionedNotAParticipant",
      },
    },
  ],
  "POST requests replyTo a queued run": [
    409,
    {
      "error": {
        "run": "<uuid>",
        "type": "RunNotReplyable",
      },
    },
  ],
  "POST requests replyTo an unknown message": [
    404,
    {
      "error": {
        "request": "<uuid>",
        "type": "RequestNotFound",
      },
    },
  ],
  "POST requests replyTo an unknown run": [
    404,
    {
      "error": {
        "run": "<uuid>",
        "type": "RunNotFound",
      },
    },
  ],
  "POST requests with an unknown field": [
    400,
    {
      "error": {
        "field": "extra",
        "message": "Unknown field.",
        "type": "InvalidInput",
      },
    },
  ],
  "POST requests, signed out": [
    401,
    {
      "error": {
        "message": "Sign in to the session first.",
        "type": "Unauthenticated",
      },
    },
  ],
  "POST requests/address, participant": [
    403,
    {
      "error": {
        "message": "Only the facilitator may do this.",
        "type": "FacilitatorOnly",
      },
    },
  ],
  "POST revisions, participant": [
    403,
    {
      "error": {
        "message": "Only the facilitator may do this.",
        "type": "FacilitatorOnly",
      },
    },
  ],
  "POST revisions/:id/restore of an unknown revision": [
    404,
    {
      "error": {
        "aggregate": "Revision",
