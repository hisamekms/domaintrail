exports[`refused requests of a session in dev mode status and body of each refusal 1`] = `
{
  "DELETE runs": [
    405,
    {
      "error": {
        "message": "Use GET or POST.",
        "type": "MethodNotAllowed",
      },
    },
  ],
  "GET an unknown API": [
    404,
    {
      "error": {
        "message": "No such session API.",
        "type": "NotFound",
      },
    },
  ],
  "GET state, signed out": [
    401,
    {
      "error": {
        "message": "Sign in to the session first.",
        "type": "Unauthenticated",
      },
    },
  ],
  "POST close, participant": [
    403,
    {
      "error": {
        "message": "Only the facilitator may do this.",
        "type": "FacilitatorOnly",
      },
    },
  ],
  "POST commands/:id/apply, participant": [
    403,
    {
      "error": {
        "message": "Only the facilitator may do this.",
        "type": "FacilitatorOnly",
      },
    },
  ],
  "POST facilitator/link, participant": [
    403,
    {
      "error": {
        "message": "Only the facilitator may do this.",
