        "type": "NotFound",
      },
    },
  ],
  "POST revisions/:id/restore, participant": [
    403,
    {
      "error": {
        "message": "Only the facilitator may do this.",
        "type": "FacilitatorOnly",
      },
    },
  ],
  "POST runs of an unknown request": [
